<aura:component implements="forceCommunity:layout" description="Custom Content Layout" access="global">
    <aura:attribute name="header" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="content" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="sidebar" type="Aura.Component[]" required="false"></aura:attribute>
    <aura:attribute name="footer" type="Aura.Component[]" required="false"></aura:attribute>
 
    <div class="container">
        <div class="contentPanel">
            <div class="header" data-key="header">
                {!v.header}
            </div>
            <div class="left slds-show_medium" data-key="sidebar">
                {!v.sidebar}
            </div>
            <div class="right" data-key="right">
                {!v.content}
            </div>
            <div class="footer" data-key="footer">
                {!v.footer}
            </div>
        </div>
    </div>
</aura:component>