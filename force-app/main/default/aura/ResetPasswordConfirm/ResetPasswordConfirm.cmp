<aura:component implements="forceCommunity:availableForAllPageTypes" access="global" controller="UserAuthenticationController">
	<aura:attribute name="username" type="String" />
    <aura:attribute name="key" type="String" />
    <aura:attribute name="password" type="String" />
    <aura:attribute name="passwordconfirm" type="String" />
    <aura:attribute name="errormessage" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:handler name="change" value="{!v.password}" action="{!c.checkPassword}"/>
    <aura:handler name="change" value="{!v.passwordconfirm}" action="{!c.checkPassword}"/>
	<span onkeypress="{c.keyCheck}"><lightning:card >
    	<aura:set attribute="title">
        	Reset Password
        </aura:set>
        <lightning:layout >
          	<lightning:layoutItem padding="around-small" size="8">
            	<form class="slds-form--stacked">
                    <lightning:input type="password" aura:id="password" label="New Password"
                             name="password"
                             value="{!v.password}"
                             messageWhenBadInput="Password and Confirmation must match." /> 
                    <lightning:input type="password" aura:id="passwordconfirm" label="Confirm Password"
                             name="passwordconfirm"
                             value="{!v.passwordconfirm}"
                             messageWhenBadInput="Password and Confirmation must match." /> 
                    <aura:if isTrue="{!v.errormessage != null}">
                    	<div class="slds-has-error">
                            <div class="slds-form-element__help">
                            	{!v.errormessage}
                            </div>                       
                    	</div>
                    </aura:if>
                    <lightning:button label="Reset Password" 
                              class="slds-m-top--medium"
                              variant="brand"
                              onclick="{!c.resetClick}"/>
                </form>
            </lightning:layoutItem>
        </lightning:layout>
    </lightning:card>
        </span>
</aura:component>