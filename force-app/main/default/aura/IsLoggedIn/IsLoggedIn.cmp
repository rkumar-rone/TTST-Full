<aura:component implements="forceCommunity:availableForAllPageTypes" access="global" controller="UserAuthenticationController">
    <lightning:navigation aura:id="navService"/>
	<aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:registerEvent name="loggedInEvent" type="c:LoggedIn"/>
</aura:component>