            </lightning:layoutItem>
            </aura:if>
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="Mobile Phone"
                             name="phone"
                             value="{!v.phone}"
                             required="true"
                             /> 
            </lightning:layoutItem>
            <aura:if isTrue="{!or(and(v.grandtotal != 0.00, v.total != 0.00), and(v.course.c.Cancellation_Fee__c != null, v.course.c.Cancellation_Fee__c != 0.00), and(v.course.c.No_Show_Fee__c == null, v.course.c.No_Show_Fee__c != 0.00))}">
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="Card Number"
                             name="cardno"
                             value="{!v.cardno}"
                             required="true"
                             /> 
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="CV Code"
                             name="cvv"
                             value="{!v.cvv}"
                             title="The CV code is the three digit code on the back of your card or four digits on the front for Amex."
                             required="true"
                             /> 
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:select label="Expiration Month"
                             name="month"
                             value="{!v.month}"
                             required="true"
                             > 
                    <option value=""></option>
                    <option value="01">January</option>
                    <option value="02">February</option>
                    <option value="03">March</option>
                    <option value="04">April</option>
                    <option value="05">May</option>
                    <option value="06">June</option>
                    <option value="07">July</option>
                    <option value="08">August</option>
                    <option value="09">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </lightning:select>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:select label="Expiration Year"
                             name="year"
                             value="{!v.year}"
                             required="true"
                             > 
                    <option value=""></option>
                    <aura:iteration items="{!v.years}" var="year">
            			<option text="{!year}" value="{!year}"/>
        			</aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
                </aura:if>
            <lightning:layoutItem padding="horizontal-medium" size="12" >
                <aura:if isTrue="{!not(v.same)}">
                    <label class="slds-form-element__label" >
      						Participant Email
                        </label>
                    <lightning:helptext content="If you need to edit your email address please go to your profile." class="htext"/>
                	<lightning:input type="text" class="nolabel" disabled="true" value="{!v.email}"/>
            	</aura:if>
                <aura:if isTrue="{!v.same}">
                	<lightning:input type="text" label="Additional Confirmation Emails To?" value="{!v.cholderemail}"/>
                </aura:if>
             </lightning:layoutItem>
            <aura:if isTrue="{!or(and(v.total != 0.00, v.grandtotal != 0.00), and(v.course.c.Cancellation_Fee__c != null, v.course.c.Cancellation_Fee__c != 0.00), and(v.course.c.No_Show_Fee__c == null, v.course.c.No_Show_Fee__c != 0.00))}">
                <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                    &nbsp;
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!not(empty(v.course.c.Affirmation_Statement__c))}">
                <lightning:layoutItem padding="horizontal-medium" size="12">
                <!--<lightning:input type="checkbox" label="{!v.course.c.Affirmation_Statement__c}" required="true" checked="{!v.affirm}" messageWhenValueMissing="You must check the affirmation statement to register." aura:id="validitycheck"/>-->
                <div class="{!'slds-form-element' + if(v.showAffirm, ' slds-has-error', '')}" lightning-input_input-host="">
                    <span lightning-input_input="" data-aria="" class="slds-assistive-text"></span>
                    <div lightning-input_input="" class="slds-form-element__control slds-grow">
                        <span lightning-input_input="" class="slds-checkbox">
                            <input type="checkbox" id="agreeTerms" name="agreeTerms" aura:id="agreeTerms" onchange="{!c.changeTerms}"/>
                                <label lightning-input_input="" class="slds-checkbox__label" for="agreeTerms">
                                    <span lightning-input_input="" class="slds-checkbox_faux"></span>
                                    <span lightning-input_input="" class="slds-form-element__label"><aura:unescapedHtml value="{!v.course.c.Affirmation_Statement__c}" /></span>
                                </label>
                        </span>
                    </div>
                    <aura:if isTrue="{!v.showAffirm}"><div lightning-input_input="" id="help-message-28" data-help-message="" role="alert" class="slds-form-element__help">You must check the affirmation statement to register.</div></aura:if>
                </div>
                </lightning:layoutItem>
            </aura:if>
            <lightning:layoutItem padding="horizontal-medium" size="12" class="slds-p-horizontal_medium slds-p-vertical_small slds-hide_small">
                <lightning:button label="Back" 
                              variant="neutral"
                              onclick="{!c.cancel}" class="fill-button"/>
            </lightning:layoutItem>
            <lightning:layoutItem size="12" class="slds-p-horizontal_medium slds-p-vertical_small slds-hide_small">
            <lightning:button label="Register" 
                              variant="brand"
                              onclick="{!c.registerClick}" class="fill-button"/>
            </lightning:layoutItem>
                <lightning:layoutItem size="12" class="slds-p-horizontal_medium slds-p-vertical_small slds-show_small">
                    <lightning:button label="Back" 
                              variant="neutral"
                              onclick="{!c.cancel}"/>
                    <lightning:button label="Register" 
                              variant="brand"
                              onclick="{!c.registerClick}"/>
            </lightning:layoutItem>
            
            
            
                <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                    &nbsp;
            </lightning:layoutItem>
            <aura:if isTrue="{!v.errormessage != null}">
	        	<lightning:layoutItem class="slds-has-error slds-p-horizontal_medium" size="12">
	            	<div class="slds-form-element__help">
	        	   		{!v.errormessage}
	    	    	</div>                       
                </lightning:layoutItem>
    		</aura:if>
<!--<tr><td><apex:inputCheckBox value="{!event.selected}"><apex:actionSupport event="onchange" action="{!event.selectItem}" rerender="tab"/></apex:inputCheckBox></td><td><apex:outputText value="" style="font-size:1.1em"/></td><td style="font-size:1.1em"></td><td style="font-size:1.1em">/td><td style="font-size:1.1em">/td><td style="font-size:1.1em">/td></tr></apex:outputPanel>
                            <tr><td style="font-weight: bold;font-size: 1.1em;font-family: Arial, Helvetica, sans-serif;text-align: left;">Individual Sessions</td><td style="font-weight: bold;font-size: 1.1em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">Session Name</td><td style="font-weight: bold;font-size: 1.1em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">Date</td><td style="font-weight: bold;font-size: 1.1em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">Start Time</td><td style="font-weight: bold;font-size: 1.1em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">End Time</td><td style="font-weight: bold;font-size: 1.1em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;"># Waiting List Members</td></tr> 
                            <apex:repeat value="{!event.sessions}" var="session"><tr></tr>
                            <tr><td><apex:outputPanel layout="none" rendered="{!NOT(allRequired)}" ><apex:inputCheckBox value="{!session.selected}" id="cb"><apex:actionSupport event="onchange" action="{!event.anyrelated}" rerender="tab"><apex:param name="selectedSess" value="{!session.s.Id}" assignTo="{!event.selectedSession}"/></apex:actionSupport></apex:inputCheckBox></apex:outputPanel></td><td style="font-size:1.1em">{!session.s.Name}</td><td style="font-size:1.1em">{!TEXT(MONTH(session.s.Session_Date__c)) & "/" & TEXT(DAY(session.s.Session_Date__c)) & "/" & TEXT(YEAR(session.s.Session_Date__c))}</td><td style="font-size:1.1em">{!session.s.Start_Hours__c}:{!session.s.Start_Minutes__c} {!session.s.Start_AM_PM__c}</td><td style="font-size:1.1em">{!session.s.End_Hours__c}:{!session.s.End_Minutes__c} {!session.s.End_AM_PM__c}</td><td style="font-size:1.1em"><apex:outputText value="{0, number, integer}"><apex:param value="{!session.s.Waiting_List_Members__c}"/></apex:outputText></td></tr> 
                            </apex:repeat>-->
        </lightning:layout>
    </lightning:card>
    
</aura:component>