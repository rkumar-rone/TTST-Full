<aura:component extends="c:AuthenticatedComponentAbstract" implements="forceCommunity:availableForAllPageTypes" access="global" controller="CourseManagementController">
	<aura:attribute name="course" type="Object" />
    <aura:attribute name="courseid" type="Id" />
    <aura:attribute name="fullcourse" type="Boolean" />
    <aura:attribute name="bring" type="String[]" />
    <aura:attribute name="included" type="String[]" />
    <aura:attribute name="errormessage" type="String" />
    <aura:attribute name="couponerror" type="String" />
    <aura:attribute name="confirmwaitlist" type="Boolean" default="false"/>
    <aura:attribute name="coupon" type="String" />
    <aura:attribute name="firstname" type="String" />
    <aura:attribute name="lastname" type="String" />
    <aura:attribute name="address" type="String" />
    <aura:attribute name="city" type="String" />
    <aura:attribute name="state" type="String" />
    <aura:attribute name="zip" type="String" />
    <aura:attribute name="country" type="String" />
    <aura:attribute name="phone" type="String" />
    <aura:attribute name="cardno" type="String" />
    <aura:attribute name="cvv" type="String" />
    <aura:attribute name="month" type="String" />
    <aura:attribute name="year" type="String" />
    <aura:attribute name="total" type="Decimal" default="0"/>
    <aura:attribute name="discount" type="Decimal"/>
    <aura:attribute name="earlydiscount" type="Decimal"/>
    <aura:attribute name="alreadypaid" type="Decimal"/>
    <aura:attribute name="grandtotal" type="Decimal" />
    <aura:attribute name="same" type="Boolean" default="true" />
    <aura:attribute name="cholderemail" type="String" />
    <aura:attribute name="email" type="String" />
    <aura:attribute name="years" type="List" access="PRIVATE" />
    <aura:attribute name="showAffirm" type="Boolean" default="false" />
    <aura:attribute name="customquestion" type="String" />
    <aura:attribute name="affirm" type="Boolean" default="false" />
    <aura:handler event="c:LoggedIn" action="{!c.doInit}"/>
    <aura:handler name="sessionSelected" event="c:sessionSelected" action="{!c.selectSession}" />
    <aura:handler event="c:RegisterWaitlistConfirm" action="{!c.handleWaitlist}"/>
    <lightning:overlayLibrary aura:id="overlayLib"/>
    <aura:if isTrue="{!and(v.loggedIn, not(empty(v.course.history)))}">
            	<lightning:card class="slds-p-vertical_medium grey">
    				<aura:set attribute="title">
                        <aura:iteration items="{!v.course.history}" var="h">
                        	<strong>Current Status: {!h.newValue} on <lightning:formattedDateTime value="{!h.dt}" year="numeric" day="2-digit" month="long" hour="2-digit" minute="2-digit" timeZone="{!$Locale.timezone}"/></strong>
                        </aura:iteration>
        			</aura:set>
<!--                    <p class="slds-p-horizontal_medium">
	                    <aura:iteration items="{!v.course.history}" var="h">
                        	<aura:if isTrue="{!h.firstRecord}">{!h.name} registration created on <lightning:formattedDateTime value="{!h.dt}" year="numeric" day="2-digit" month="long" hour="2-digit" minute="2-digit" /> with status {!h.newValue}<br /></aura:if>
                        	<aura:if isTrue="{!not(h.firstRecord)}">{!h.name} status changed from {!h.oldValue} to {!h.newValue} on <lightning:formattedDateTime value="{!h.dt}" year="numeric" day="2-digit" month="long" hour="2-digit" minute="2-digit" /><br /></aura:if>
	                	</aura:iteration>
                    </p>-->
                </lightning:card>
            </aura:if>
	<lightning:card class="noborder">
    	<aura:set attribute="title">
            <h3>{!v.course.c.Online_Event_Name__c}</h3>
        </aura:set>
        <lightning:layout verticalAlign="start" multipleRows="true">
          	<!--<lightning:layoutItem padding="horizontal-medium" size="12">
            	<strong>Location</strong>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
            	<aura:if isTrue="{!or(v.course.c.View_Map__c == null, v.course.c.View_Map__c == '')}"><lightning:formattedUrl value="{!'http://www.google.com/maps?hl=en&amp;safe=off&amp;q=' + v.course.c.Training_Location_Street__c + ',' + v.course.c.Training_Location_City__c + ',' + v.course.c.Training_Location_State__c + ',' + v.course.c.Training_Location_Zip_Code__c + '&amp;aq=f&amp;aqi=&amp;aql=&amp;oq=&amp;pbx=1&amp;bav=on.2,or.r_gc.r_pw.&amp;fp=a445e974b90b3339'}" target="_blank" label="{!v.course.c.Training_Location_Name__c + ', ' + v.course.c.Training_Location_Street__c + ', ' + v.course.c.Training_Location_City__c + ', ' + v.course.c.Training_Location_State__c + ', ' + v.course.c.Training_Location_Zip_Code__c}"/></aura:if>
                <aura:if isTrue="{!and(v.course.c.View_Map__c != null, v.course.c.View_Map__c != '')}"><lightning:formattedUrl value="{!v.course.c.View_Map__c}" label="{!v.course.c.Training_Location_Name__c + ', ' + v.course.c.Training_Location_Street__c + ', ' + v.course.c.Training_Location_City__c + ', ' + v.course.c.Training_Location_State__c + ', ' + v.course.c.Training_Location_Zip_Code__c}" /></aura:if>
            </lightning:layoutItem>-->
            <aura:if isTrue="{!v.course.c.Sister_Event__c != null}">
            	<lightning:layoutItem padding="horizontal-medium" size="12">
                    <strong>Alternate Date/Time</strong>
            	</lightning:layoutItem>
                <lightning:layoutItem padding="horizontal-medium" size="12">
                    <a href="view-event?id={v.course.c.Sister_Event__c}"><ui:outputDate value="{!v.course.c.Sister_Event__r.StartDate}" format="M/d/yyyy" /> - <ui:outputDate value="{!v.course.c.Sister_Event__r.EndDate}" format="M/d/yyyy" /></a>
            	</lightning:layoutItem>
            </aura:if>
            <!--<lightning:layoutItem padding="around-medium" size="12">
                <lightning:formattedRichText value="{!v.course.c.RT_Description__c}" />
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <strong>Prerequisites</strong>
            </lightning:layoutItem>-->
            <!--<lightning:layoutItem padding="horizontal-medium" size="12">
                {!v.course.c.Pre_requisites__c}
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                    <strong>What to Bring</strong>
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <ul style="list-style: disc;" class="slds-p-left_large">
                	<aura:iteration items="{!v.bring}" var="b">
                        <li>{!b}</li>
                    </aura:iteration>
                </ul>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                    <strong>What's Included</strong>
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
               	<ul style="list-style: disc;" class="slds-p-left_large">
                	<aura:iteration items="{!v.included}" var="i">
                        <li>{!i}</li>
                    </aura:iteration>
                </ul>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Additional Information</strong>
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                {!v.course.c.Additional_Information__c}
            </lightning:layoutItem>-->
            <aura:if isTrue="{!not(empty(v.course.c.Cancellation_Policy__c))}">
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Cancellation Policy</strong>
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                {!v.course.c.Cancellation_Policy__c}
            </lightning:layoutItem>
            </aura:if>
            <!--<lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Course Cost</strong>
                </div>
            </lightning:layoutItem>
            <aura:if isTrue="{!v.course.c.Early_Bird_Registration_Cost__c != null}" >
            	<lightning:layoutItem padding="horizontal-medium" size="12">
                	Early-Bird Registration Cost <lightning:formattedNumber value="{!v.course.c.Early_Bird_Registration_Cost__c}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
            	</lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!v.course.c.Early_Bird_Deadline__c != null}" >
                <lightning:layoutItem padding="horizontal-medium" size="12">
                    Early-Bird Deadline Register Before <ui:outputDate value="{!v.course.c.Early_Bird_Deadline__c}" format="M/d/yyyy" />
            	</lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!not(v.course.c.Only_Show_Sessions__c)}">
                <lightning:layoutItem padding="horizontal-medium" size="12" >
                	 Full Registration Cost <lightning:formattedNumber value="{!v.course.c.Full_Registration_Cost__c}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
            	</lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!not(v.course.allRequired)}">
                <lightning:layoutItem padding="horizontal-medium" size="12">
                	 Per-Session Cost <lightning:formattedNumber value="{!v.course.perSession}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
            	</lightning:layoutItem>
            </aura:if>   -->
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Registration Options</strong>
                </div>
            </lightning:layoutItem>
            <aura:if isTrue="{!not(v.course.c.Only_Show_Sessions__c)}">
                <lightning:layoutItem padding="none" size="1">
                    <div style="text-align:right;width:100%"><lightning:input aura:id="full" class="slds-p-left_small" style="display:inline-block" type="checkbox" checked="{!v.fullcourse}" onchange="{!c.selectFull}" />&nbsp;</div>
                </lightning:layoutItem>
                <lightning:layoutItem padding="horizontal-medium" size="11">
                	{!v.course.c.Online_Event_Name__c}
                </lightning:layoutItem>
                <!--<lightning:layoutItem padding="horizontal-medium" size="3">
                	{!v.course.c.Class_Code__c}&nbsp;
                </lightning:layoutItem>-->
                <!--<lightning:layoutItem padding="horizontal-medium" size="2">
                	<ui:outputDate value="{!v.course.c.StartDate}" format="M/d/yyyy" />
                </lightning:layoutItem>-->
                <!--<lightning:layoutItem padding="horizontal-medium" size="2">
                    <ui:outputDate value="{!v.course.c.EndDate}" format="M/d/yyyy" />
                </lightning:layoutItem>-->
            </aura:if>
			<aura:if isTrue="{!not(v.course.c.Do_Not_Display_Sessions__c)}">
            <aura:iteration items="{!v.course.sessions}" var="sess">
                <lightning:layoutItem padding="horizontal-medium" size="2" mediumDeviceSize="1">
                    <div style="width:100%;text-align:right;height:28px;">
                	<aura:if isTrue="{!sess.waitlisted}">
                        <div class="waitlist" onmouseout="{!c.hoverOutWait}" onmouseover="{!c.hoverWait}" onclick="{!c.hoverWait}">W</div>
                        <div class="slds-popover slds-popover_tooltip slds-nubbin_bottom-left hidetip tip" role="tooltip" id="help">
    						<div class="slds-popover__body">This Session is Waitlisted.</div>
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!not(sess.waitlisted)}">&nbsp;</aura:if>
                    </div>
                </lightning:layoutItem>
				<aura:if isTrue="{!not(v.course.allRequired)}">
                    <lightning:layoutItem mediumDeviceSize="7" size="10" padding="horizontal-medium">
                    	<c:SessionCheckbox id="{!sess.session.Id}" aura:id="sess" checked="{!sess.checked}" label="{!sess.session.Name}" required="{!sess.session.Required__c}" disabled="{!sess.disabled}" waitlisted="{!sess.waitlisted}"/>
                    </lightning:layoutItem>
                </aura:if>
                <aura:if isTrue="{!v.course.allRequired}">
                    <lightning:layoutItem padding="horizontal-medium" size="10" mediumDeviceSize="7">
                        {!sess.session.Name}
                    </lightning:layoutItem>
                </aura:if>
                <lightning:layoutItem padding="horizontal-medium" size="10" mediumDeviceSize="4" class="slds-show_medium smallerfont">
                    <ui:outputDate value="{!sess.session.Session_Date__c}" format="M/d/yyyy" />&nbsp;
                    {!sess.session.Start_Hours__c}:{!sess.session.Start_Minutes__c} {!sess.session.Start_AM_PM__c} - {!sess.session.End_Hours__c}:{!sess.session.End_Minutes__c} {!sess.session.End_AM_PM__c}
                </lightning:layoutItem>
                <lightning:layoutItem padding="horizontal-medium" size="2" class="slds-hide_medium">
                    &nbsp;
                </lightning:layoutItem>
                <lightning:layoutItem padding="horizontal-medium" size="10" class="slds-hide_medium smallerfont padleft">
                    <ui:outputDate value="{!sess.session.Session_Date__c}" format="M/d/yyyy" />
                </lightning:layoutItem>
                <lightning:layoutItem padding="horizontal-medium" size="2" class="slds-hide_medium">
                    &nbsp;
                </lightning:layoutItem>
                <lightning:layoutItem padding="horizontal-medium" size="10" class="slds-hide_medium smallerfont padleft">
                    {!sess.session.Start_Hours__c}:{!sess.session.Start_Minutes__c} {!sess.session.Start_AM_PM__c} - {!sess.session.End_Hours__c}:{!sess.session.End_Minutes__c} {!sess.session.End_AM_PM__c}
                </lightning:layoutItem>
           	</aura:iteration>
            </aura:if>
            <aura:if isTrue="{!not(v.course.c.Do_Not_Display_Pricing__c)}">
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Total</strong>&nbsp;<lightning:formattedNumber value="{!v.total}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
                </div>
            </lightning:layoutItem>
            <aura:if isTrue="{!v.earlydiscount != null}">
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Early Discount</strong>&nbsp;<lightning:formattedNumber value="{!v.earlydiscount}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
                </div>
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!v.discount != null}">
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Coupon Code</strong>&nbsp;<lightning:formattedNumber value="{!v.discount}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
                </div>
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!v.alreadypaid != null}">
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Already Billed</strong>&nbsp;<lightning:formattedNumber value="{!v.alreadypaid}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
                </div>
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!v.grandtotal != null}">
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Grand Total</strong>&nbsp;<lightning:formattedNumber value="{!v.grandtotal}" currencyCode="{!v.course.c.CurrencyIsoCode}" style="currency"/>
                </div>
            </lightning:layoutItem>
            </aura:if>
            
            <!--<lightning:layoutItem padding="horizontal-medium" size="6">
                    <div class="accordion collapsed">
                    <a href="#" onclick="{!c.toggleAccordion}">
                        <div class="accordionheader">
                        	Add a Coupon Code
	                    </div>
                    </a>
                    <div class="accordionbody">-->

            <lightning:layoutItem size="12" smallDeviceSize="6"  class="slds-p-horizontal_medium slds-p-vertical_small">
                <span onkeypress="{!c.checkKeyPressCoupon}">
             		<lightning:input placeholder="Have a Coupon Code?"
                             name="coupon"
                             value="{!v.coupon}"
							 aura:id="coupon"
                             class="coupon blank" onchange="{!c.changeColor}"/>
                    </span>
            </lightning:layoutItem>
            <lightning:layoutItem class="slds-p-horizontal_medium slds-p-vertical_small" size="12" smallDeviceSize="6">
                    <lightning:button label="Apply Coupon" 
                              variant="neutral"
                              aura:id="addcoupon"
                              class="coupbutt"
                              onclick="{!c.getTotalCoupon}"/>
            </lightning:layoutItem>
                <lightning:layoutItem size="12">
                <aura:if isTrue="{!not(empty(v.couponerror))}">
                        	<div class="slds-has-error slds-m-left--medium">
            					<div class="slds-form-element__help">
        	   						{!v.couponerror}
    	    					</div>                       
      						</div>
                        </aura:if>
                </lightning:layoutItem>
                    <!--    </div>
                    </div>
                </lightning:layoutItem>-->
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <div class="slds-p-top_medium">
                	<strong>Payment Information</strong>
                </div>
            </lightning:layoutItem>   
                
            <lightning:layoutItem padding="horizontal-medium" size="6">&nbsp;
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12">
                <lightning:input type="checkbox" label="Same as Participant" onchange="{!c.changeCheck}" checked="{!v.same}"/>
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!not(empty(v.course.c.Custom_Picklist_Label__c))}">
                	<lightning:layoutItem padding="horizontal-medium" size="12">
                        <lightning:select name="customquestion" label="{!v.course.c.Custom_Picklist_Label__c}" value="{!v.customquestion}" required="true">
                         	<aura:iteration items="{!v.course.customChoices}" var="option">
            					<option text="{!option}" value="{!option}" />
        					</aura:iteration>
                        </lightning:select>
                    </lightning:layoutItem>
            </aura:if>
            <lightning:layoutItem padding="horizontal-medium" size="12">
            	<aura:if isTrue="{!not(v.same)}">                    
            		<lightning:input label="Cardholder Email" type="text" value="{!v.cholderemail}"/>
            	</aura:if>
                <aura:if isTrue="{!v.same}">
                    <label class="slds-form-element__label" >
      						Participant Email
                        </label>
                    <lightning:helptext content="If you need to edit your email address please go to your profile." class="htext"/>
                	<lightning:input type="text" class="nolabel" disabled="true" value="{!v.email}"/>
                </aura:if>
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="First Name"
                             name="firstname"
                             value="{!v.firstname}"
                             required="true"
                             /> 
            </lightning:layoutItem>
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="Last Name"
                             name="lastname"
                             value="{!v.lastname}"
                             required="true"
                             /> 
            </lightning:layoutItem>
            <aura:if isTrue="{!or(and(v.grandtotal != 0.00, v.total != 0.00), and(v.course.c.Cancellation_Fee__c != null, v.course.c.Cancellation_Fee__c != 0.00), and(v.course.c.No_Show_Fee__c == null, v.course.c.No_Show_Fee__c != 0.00))}">
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="Address"
                             name="address"
                             value="{!v.address}"
                             required="true"
                             /> 
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!or(and(v.grandtotal != 0.00, v.total != 0.00), and(v.course.c.Cancellation_Fee__c != null, v.course.c.Cancellation_Fee__c != 0.00), and(v.course.c.No_Show_Fee__c == null, v.course.c.No_Show_Fee__c != 0.00))}">
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="City"
                             name="city"
                             value="{!v.city}"
                             required="true"
                             /> 
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!or(and(v.grandtotal != 0.00, v.total != 0.00), and(v.course.c.Cancellation_Fee__c != null, v.course.c.Cancellation_Fee__c != 0.00), and(v.course.c.No_Show_Fee__c == null, v.course.c.No_Show_Fee__c != 0.00))}">
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="State/Province/Region"
                             name="state"
                             value="{!v.state}"
                             /> 
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!or(and(v.grandtotal != 0.00, v.total != 0.00), and(v.course.c.Cancellation_Fee__c != null, v.course.c.Cancellation_Fee__c != 0.00), and(v.course.c.No_Show_Fee__c == null, v.course.c.No_Show_Fee__c != 0.00))}">
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:input label="Postal Code"
                             name="zip"
                             value="{!v.zip}"
                             required="true"
                             /> 
            </lightning:layoutItem>
            </aura:if>
            <aura:if isTrue="{!or(and(v.grandtotal != 0.00, v.total != 0.00), and(v.course.c.Cancellation_Fee__c != null, v.course.c.Cancellation_Fee__c != 0.00), and(v.course.c.No_Show_Fee__c == null, v.course.c.No_Show_Fee__c != 0.00))}">
            <lightning:layoutItem padding="horizontal-medium" size="12" smallDeviceSize="6">
                <lightning:select label="Country"
                             name="country"
                             value="{!v.country}"
                             required="true"
                             > 
                    <option value=""></option>
<option value="US">United States</option>
<option value="AF">Afghanistan</option>
<option value="AX">Åland Islands</option>
<option value="AL">Albania</option>
<option value="DZ">Algeria</option>
<option value="AS">American Samoa</option>
<option value="AD">Andorra</option>
<option value="AO">Angola</option>
<option value="AI">Anguilla</option>
<option value="AQ">Antarctica</option>
<option value="AG">Antigua and Barbuda</option>
<option value="AR">Argentina</option>
<option value="AM">Armenia</option>
<option value="AW">Aruba</option>
<option value="AU">Australia</option>
<option value="AT">Austria</option>
<option value="AZ">Azerbaijan</option>
<option value="BS">Bahamas</option>
<option value="BH">Bahrain</option>
<option value="BD">Bangladesh</option>
<option value="BB">Barbados</option>
<option value="BY">Belarus</option>
<option value="BE">Belgium</option>
<option value="BZ">Belize</option>
<option value="BJ">Benin</option>
<option value="BM">Bermuda</option>
<option value="BT">Bhutan</option>
<option value="BO">Bolivia, Plurinational State of</option>
<option value="BQ">Bonaire, Sint Eustatius and Saba</option>
<option value="BA">Bosnia and Herzegovina</option>
<option value="BW">Botswana</option>
<option value="BV">Bouvet Island</option>
<option value="BR">Brazil</option>
<option value="IO">British Indian Ocean Territory</option>
<option value="BN">Brunei Darussalam</option>
<option value="BG">Bulgaria</option>
<option value="BF">Burkina Faso</option>
<option value="BI">Burundi</option>
<option value="KH">Cambodia</option>
<option value="CM">Cameroon</option>
<option value="CA">Canada</option>
<option value="CV">Cape Verde</option>
<option value="KY">Cayman Islands</option>
<option value="CF">Central African Republic</option>
<option value="TD">Chad</option>
<option value="CL">Chile</option>
