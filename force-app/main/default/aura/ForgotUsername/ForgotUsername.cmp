<aura:component implements="forceCommunity:availableForAllPageTypes" access="global" controller="UserAuthenticationController">
    <aura:attribute name="email" type="String" />
    <aura:attribute name="message" type="String" />
	<lightning:card >
    	<aura:set attribute="title">
        	Forgot Username
        </aura:set>
        <lightning:layout >
          	<lightning:layoutItem padding="around-small" size="8">
            	<form class="slds-form--stacked">
                    <lightning:input aura:id="logform" label="Email"
                             name="email"
                             value="{!v.email}"
                             required="true"
                             placeholder="Email"/> 
                    <aura:if isTrue="{!v.message != null}">
                    	<div class="slds-has-error">
                            <div class="slds-form-element__help">
                            	{!v.message}
                            </div>                       
                    	</div>
                    </aura:if>
                    <lightning:button label="Send Email With Username" 
                              class="slds-m-top--medium"
                              variant="brand"
                              onclick="{!c.forgotClick}"/>
                </form>
            </lightning:layoutItem>
        </lightning:layout>
    </lightning:card>
</aura:component>