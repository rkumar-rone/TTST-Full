<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Saltbox Bundle Items</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="titleColor"
                type="Color"
                label="Title Color"
                default="#000000"
            />
            <property name="title" type="String" label="Component Title Label"/>
            <property name="name" type="String" label="Name Column Label"/>
            <property name="code" type="String" label="SKU Column Label"/>
            <property name="description" type="String" label="Description Label"/>
        </targetConfig>
    </targetConfigs>

</LightningComponentBundle>