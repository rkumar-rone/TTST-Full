<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Product Detail Recommendations</masterLabel>
    <targets>
		<target>lightningCommunity__Page</target>
		<target>lightningCommunity__Default</target>
	</targets>
  <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property label="Record Id" name="recordId" type="String"  description="Automatically bind the page's record id to the component variable" default="{!recordId}"/>
            <property label="Product Data Binding" name="product" type="String" default="{!Product.Details}" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>