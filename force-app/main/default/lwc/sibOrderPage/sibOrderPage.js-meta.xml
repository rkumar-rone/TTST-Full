<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Order Detail Page</masterLabel>
    <description>Order Detail Page</description>
	<targets>
		<target>lightningCommunity__Page</target>
		<target>lightningCommunity__Default</target>
	</targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property label="Order Data Binding" name="orderDetails" type="String" default="{!Order.Details}" />
            <property name="recordId" type="String" label="Record Id" description="Automatically bind the page's record id to the component variable" default="{!recordId}"/>
            <property name="pageType" type="String" label="Page Type" description="Order Confirmation/Order Detail" default="Order Detail"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>