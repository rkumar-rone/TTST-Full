                                      <img data-assetid="71" src="{!URLFOR($Resource.SIBTheme, 'images/TrainingTheStreetEmailLogo.png')}" alt="TrainingTheStreetLogo"  style="display: block; height: 71px; width: auto; text-align: center; padding: 0px;"></img> </td></tr></table></td></tr></table></td></tr></table>
                                </td>
                              </tr>
                              <tr>
                                <td align="left" class="" valign="top">
                                  <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="border: 0px solid transparent; background-color: transparent; min-width: 100%; " class="slot-styling"><tr><td style="padding: 10px 0px; " class="slot-styling camarker-inner"><table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="min-width: 100%; " class="stylingblock-content-wrapper"><tr><td class="stylingblock-content-wrapper camarker-inner">Order Date:<span> <apex:outputText value="{0,date,MM/dd/yy}"> <apex:param value="{!OrderSummary.OrderedDate}" /></apex:outputText></span>
                                      <br/>Order #:&nbsp; <span>{!OrderSummary.OriginalOrder.OrderNumber}</span>
                                      <apex:outputPanel rendered="{!NOT(ISBLANK(OrderSummary.PoNumber))}">
                                          <div>
                                              PO Number:&nbsp;<span>{!OrderSummary.PoNumber}</span>
                                          </div>
                                      </apex:outputPanel>
                                      </td></tr></table>
                                      <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="min-width: 100%; " class="stylingblock-content-wrapper"><tr><td class="stylingblock-content-wrapper camarker-inner"><h2 style="color:#202020;font-family:Arial,helvetica,sans-serif;font-size:22px;font-style:normal;font-weight:bold;line-height:1;">
 Course Ordered</h2><table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
 <thead>
  <tr>
   <th scope="col" style="text-align: left;">
    Name</th><th scope="col">
    Quantity</th><th scope="col"  style="text-align: right;padding-right: 1rem;">
    Unit Price</th></tr></thead>
<apex:repeat var="item" value="{!OrderItems}">
  <tr>
   <td style="width: 60%;">
    {!item.productName}</td><td style="text-align: center;">
    {!ROUND(item.quantity, 0)}</td>
    <td style="text-align: right;padding-right: 1rem;">
      <apex:outputText value="{0,Number,{!CurrencySymbol}###,##0.00}">
        <apex:param value="{!item.unitPrice}"></apex:param>
      </apex:outputText>
    </td></tr></apex:repeat>
    </table><h2 style="color:#202020;font-family:Arial,helvetica,sans-serif;font-size:22px;font-style:normal;font-weight:bold;line-height:1;">
 Order Summary</h2><table border="0" cellpadding="0" cellspacing="0" style="width:59%;">
 
  <tr>
    <td>
     Registration Fees</td><td  style="text-align: right;">
      <apex:outputText value="{0,Number,{!CurrencySymbol}###,##0.00}">
        <apex:param value="{!OrderSummary.TotalProductAmount}"></apex:param>
      </apex:outputText>
      <!--{!CurrencySymbol}{!OrderSummary.TotalProductAmount}--></td>
  </tr>
  <tr>
    <td>
     Discounts</td><td  style="text-align: right;">
      <apex:outputText value="{0,Number,{!CurrencySymbol}###,##0.00}">
        <apex:param value="{!ABS(OrderSummary.TotalProductAmount - OrderSummary.TotalAmount)}"></apex:param>
      </apex:outputText></td>
  </tr>
  <tr>
    <td>
     Subtotal</td><td  style="text-align: right;">
     <apex:outputText value="{0,Number,{!CurrencySymbol}###,##0.00}">
        <apex:param value="{!OrderSummary.TotalAmount}"></apex:param>
      </apex:outputText></td>
  </tr>
  <tr>
    <td>
     Tax</td><td style="text-align: right;">
     <apex:outputText value="{0,Number,{!CurrencySymbol}###,##0.00}">
        <apex:param value="{!OrderSummary.TotalTaxAmount}"></apex:param>
      </apex:outputText></td>
   </tr>
  <tr>
   <td>
    Total Due</td><td style="text-align: right;">
    <apex:outputText value="{0,Number,{!CurrencySymbol}###,##0.00}">
        <apex:param value="{!OrderSummary.GrandTotalAmount}"></apex:param>
      </apex:outputText></td></tr></table>&nbsp;<table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
 <thead>
  <tr>
   <th scope="col" style="text-align: left;">
    Billing Address</th></tr></thead>
  <tr>
   <td>
    {!OrderSummary.BillingStreet}</td></tr>
    <tr>
   <td>    
        {!IF(NOT(ISBLANK(OrderSummary.BillingCity)),OrderSummary.BillingCity, "")}{!IF(AND(NOT(ISBLANK(OrderSummary.BillingCity)), NOT(ISBLANK(OrderSummary.BillingStateCode))), ",", "")}        
        {!IF(NOT(ISBLANK(OrderSummary.BillingStateCode)),OrderSummary.BillingStateCode, "")}{!IF(AND(NOT(ISBLANK(OrderSummary.BillingCity)), NOT(ISBLANK(OrderSummary.BillingPostalCode)),ISBLANK(OrderSummary.BillingPostalCode)), ",", "")}        
        {!IF(NOT(ISBLANK(OrderSummary.BillingPostalCode)),OrderSummary.BillingPostalCode, "")}
      </td></tr>
    
     <tr><td>
    {!OrderSummary.BillingCountry}</td>
                                      </tr></table></td></tr></table></td></tr></table>
                                </td>
                              </tr>
                              <apex:outputPanel rendered="{!isSelfStudyOrder}">
                              <tr >
                                <td>
                                  <span>
                                    Click this link to view our suggested course competition order and start your learning journey: <a href="https://trainingthestreet.com/self-study-completion-order/">Click Here</a>
                                  </span>
                                </td>
                              </tr>
                            </apex:outputPanel>
                              <tr>
                                <td align="left" class="" valign="top">
                                  <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="border: 0px solid transparent; background-color: transparent; min-width: 100%; " class="slot-styling"><tr><td style="padding: 10px 0px; " class="slot-styling camarker-inner"><table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="min-width: 100%; " class="stylingblock-content-wrapper"><tr><td class="stylingblock-content-wrapper camarker-inner"><table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation"><tr><td align="center"><table border="0" cellspacing="0" cellpadding="0" role="presentation"><tr><td class="innertd buttonblock" bgcolor="#1D4697" style=" border-radius: 3px; -moz-border-radius: 3px; -webkit-border-radius: 3px; background-color: #1D4697;"><apex:outputlink value="{!SiteURL}" target="_blank" style=" font-size: 16px; font-family: Arial, helvetica, sans-serif; color: #FFFFFF; text-align: center; text-decoration: none; display: block; background-color: #1D4697; border: 1px solid #1D4697; padding: 10px; border-radius: 3px; -moz-border-radius: 3px; -webkit-border-radius: 3px;" title="">View Order</apex:outputlink></td></tr></table></td></tr></table></td></tr></table></td></tr></table>
                                </td>
                              </tr>
        
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>

    </table>
  </body>
</html>

</apex:component>