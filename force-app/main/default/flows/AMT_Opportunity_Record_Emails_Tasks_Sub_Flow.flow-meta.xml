    <decisions>
        <name>Checklist_Requested_EDD_Changed</name>
        <label>Checklist Requested - EDD Changed?</label>
        <locationX>1172</locationX>
        <locationY>710</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.Materials_Publications_Delivery_Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>PriorOpportunityRecord.Materials_Publications_Delivery_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.MatLog_Generated_Opportunity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final Outline Ready &gt;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Logistics Confirmed &gt;</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_to_Claudine_Sauvetre_Materials_Team</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Opportunity_Stage</name>
        <label>Determine Opportunity Stage</label>
        <locationX>1172</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>Checklist_Requested_EDD_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Closed_Won</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>PriorOpportunityRecord.StageName</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Determine_to_Revert_the_Stage</targetReference>
            </connector>
            <label>Closed Won</label>
        </rules>
        <rules>
            <name>Dates_Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Dates Confirmed &gt;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>PriorOpportunityRecord.StageName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dates_Confirmed_Email_to_scheduling_amttraining_com</targetReference>
            </connector>
            <label>Dates Confirmed</label>
        </rules>
        <rules>
            <name>Dates_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Dates Requested &gt;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>PriorOpportunityRecord.StageName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dates_Requested_Email_to_scheduling_amttraining_com</targetReference>
            </connector>
            <label>Dates Requested</label>
        </rules>
        <rules>
            <name>Final_Outline_Ready</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final Outline Ready &gt;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>PriorOpportunityRecord.StageName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_to_Materials_Team_scheduling_amttraining_com</targetReference>
            </connector>
            <label>Final Outline Ready</label>
        </rules>
        <rules>
            <name>Logistics_Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Logistics Confirmed &gt;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
