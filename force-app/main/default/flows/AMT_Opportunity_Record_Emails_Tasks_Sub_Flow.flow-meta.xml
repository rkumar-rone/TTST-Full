    </decisions>
    <decisions>
        <name>Determine_to_Revert_the_Stage</name>
        <label>Determine to Revert the Stage?</label>
        <locationX>182</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Create_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Account_on_Creation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.Account.Account_Code__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>AMTO,AMTPUB,AMAPUB,AMUPUB</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Stage_as_Initial_Enquiry_no_dates_requested</targetReference>
            </connector>
            <label>Valid Account on Creation</label>
        </rules>
    </decisions>
    <description>This subflow is used to process the AMT Opportunity records and send the timely notifications based on Stage.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>{!IsNewRecord}</expression>
    </formulas>
    <formulas>
        <name>TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()+1</expression>
    </formulas>
