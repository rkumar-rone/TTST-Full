                    <elementReference>PriorOpportunityRecord.StageName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Logistics_Email_to_Materials_Team_scheduling_amttraining_com</targetReference>
            </connector>
            <label>Logistics Confirmed</label>
        </rules>
        <rules>
            <name>S_Handover_to_CSM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>S - Handover to CSM &gt;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>PriorOpportunityRecord.StageName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_Carmen_Li</targetReference>
            </connector>
            <label>S - Handover to CSM</label>
        </rules>
        <rules>
            <name>Closed_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
