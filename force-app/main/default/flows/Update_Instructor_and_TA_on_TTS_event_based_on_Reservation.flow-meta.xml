    <formulas>
        <description>Remove double quotes</description>
        <name>allInsquote</name>
        <dataType>String</dataType>
        <expression>
SUBSTITUTE( {!allInstructors}, &apos;&quot;&apos;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Remov edouble quites from all TA</description>
        <name>allTAquote</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!allTA}, &apos;&quot;&apos;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Instructor1</name>
        <dataType>String</dataType>
        <expression>LEFT({!allInsquote}, 18)</expression>
    </formulas>
    <formulas>
        <name>Instructor2</name>
        <dataType>String</dataType>
        <expression>LEFT(
RIGHT({!allInsquote}, (LEN({!allInsquote})-FIND(&apos;,0&apos;,  {!allInstructors} )) - 20), 18
)</expression>
    </formulas>
    <formulas>
