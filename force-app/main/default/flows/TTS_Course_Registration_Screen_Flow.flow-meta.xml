    <description>Updated to respect GR status to not allow over-booking
With Disabled Course screen for not loggen in
With correct verbiage in disabled Course screen for not loggen in
With no course info if registration is closed
With Dynamic Domain
Replaced static URLs with Custom labels and introduced a custom LWC for redirection to support LWR as well (R1)
added Scroll LWC CMp</description>
    <environments>Default</environments>
    <formulas>
        <name>availability</name>
        <dataType>Number</dataType>
        <expression>{!Get_TTS_Event_Info.Seats_Available__c} - {!Get_TTS_Event_Info.Registered__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ConfirmationURL</name>
        <dataType>String</dataType>
        <expression>{!Store_Domain}+&quot;/course-confirmation?CourseId=&quot;+{!TrimmedCourseId}+&quot;&amp;IsWaitlisted=&quot;+{!isWaitlisted}</expression>
    </formulas>
    <formulas>
        <name>IdPrefix</name>
        <dataType>String</dataType>
        <expression>LEFT({!CourseId},3)</expression>
    </formulas>
    <formulas>
        <name>Store_Domain</name>
        <dataType>String</dataType>
        <expression>IF({!$Label.SIB_DefaultStorename}==&apos;TTS B2B Store(LWR)&apos;, {!$Label.SIB_LWRSiteURL}, {!$Label.SIB_AuraSiteURL})</expression>
    </formulas>
    <formulas>
        <name>TrimmedCourseCode</name>
        <dataType>String</dataType>
        <expression>LEFT({!CourseCode}, 6)</expression>
    </formulas>
    <formulas>
        <name>TrimmedCourseId</name>
        <dataType>String</dataType>
        <expression>LEFT({!CourseId}, 15)</expression>
    </formulas>
