    <formulas>
        <description>Uses a formula to create a unique alias value for new user creation</description>
        <name>AliasFormula</name>
        <dataType>String</dataType>
        <expression>LEFT({!Last_Name}+TEXT({!$Flow.CurrentDate}), 8)</expression>
    </formulas>
    <formulas>
        <name>NickName_Formula</name>
        <dataType>String</dataType>
        <expression>LEFT({!Nick_Name}+TEXT({!$Flow.CurrentDate}), 12)</expression>
    </formulas>
    <formulas>
        <name>SalesforceUsername</name>
        <dataType>String</dataType>
        <expression>{!accountRecord.Strivacity_Identifier__pc}+&quot;@tts.user&quot;</expression>
    </formulas>
