<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <decisions>
        <description>Delivery Format Check</description>
        <name>Delivery_Format_Check</name>
        <label>Delivery Format Check</label>
        <locationX>314</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Delivery_Format_check_to_populate</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Delivery_Format__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Virtual (Instructor-led)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Delivery_Format__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No Instruction/LMS Only</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Delivery_Format__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TBD</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Region_Records</targetReference>
            </connector>
            <label>Delivery Format check to populate Opportunity Owner Region</label>
        </rules>
        <rules>
            <name>Delivery_Format_check_to_populate_Training_location_Region</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Delivery_Format__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In-person</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_opportunity_region_records_1</targetReference>
            </connector>
            <label>Delivery Format check to populate Training location Region</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Set Opportunity Region {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Opportunity Region</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Opportunity Region Records</description>
        <name>Get_Opportunity_Region_Records</name>
        <label>Get Opportunity Region Records</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Opp_region_with_Opp_owner_region</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Owner.Country</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity_Regions__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_opportunity_region_records_1</name>
        <label>Get opportunity region records</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Opp_region_with_training_country_region</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Training_Location_Country__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity_Regions__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opp_region_with_Opp_owner_region</name>
        <label>Update Opp region with Opp owner region</label>
        <locationX>50</locationX>
        <locationY>551</locationY>
        <inputAssignments>
            <field>Opportunity_region__c</field>
            <value>
                <elementReference>Get_Opportunity_Region_Records.Region__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opp_region_with_training_country_region</name>
        <label>Update Opp region with training country region</label>
        <locationX>314</locationX>
        <locationY>551</locationY>
        <inputAssignments>
            <field>Opportunity_region__c</field>
            <value>
                <elementReference>Get_opportunity_region_records_1.Region__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
