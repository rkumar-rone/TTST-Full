    <decisions>
        <description>Determining TTS event record type to use when creating TTS event  based on account&apos;s client type</description>
        <name>TTS_Event_Record_Type_To_Use</name>
        <label>TTS Event Record Type To Use</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Corporate</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Corporate</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Individuals</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Corporate_TTS_Event</targetReference>
            </connector>
            <label>Corporate</label>
        </rules>
        <rules>
            <name>Public_Courses</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Public Courses</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal TTS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Public_Event_TTS_Event</targetReference>
            </connector>
            <label>Public Courses</label>
        </rules>
        <rules>
            <name>Self_study_Udemy</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Self-Study</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_SelfStudy_Product_TTS_Event</targetReference>
            </connector>
            <label>Self-study/Udemy</label>
        </rules>
        <rules>
            <name>Academic_Event</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Graduate Academic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Client_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>UG Academic</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Academic_TTS_Event</targetReference>
            </connector>
            <label>Academic Event</label>
        </rules>
    </decisions>
