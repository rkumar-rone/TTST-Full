    <decisions>
        <name>Is_Active_Buyer</name>
        <label>Is Active Buyer?</label>
        <locationX>358</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Create_Buyer_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not A Buyer</defaultConnectorLabel>
        <rules>
            <name>Active_Buyer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Buyer_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Buyer_Account.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Disable_Buyer_Account</targetReference>
            </connector>
            <label>Active Buyer</label>
        </rules>
        <rules>
            <name>Inactive_Buyer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Buyer_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Buyer_Account.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reactivate_Buyer_Account</targetReference>
            </connector>
            <label>Inactive Buyer</label>
        </rules>
    </decisions>
