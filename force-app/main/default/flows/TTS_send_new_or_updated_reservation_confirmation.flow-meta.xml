    <decisions>
        <description>checks if an email should be sent for this reservation, and what kind of email</description>
        <name>which_email_should_be_sent</name>
        <label>which email should be sent?</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>no email</defaultConnectorLabel>
        <rules>
            <name>data_missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Instructor_email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>data missing</label>
        </rules>
        <rules>
            <name>new_reservation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.B25__Resource__r.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.B25__Resource__r.Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.B25__Reservation_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>aDh7e000000L2zlCAC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_reservation_confirmation</targetReference>
            </connector>
            <label>new reservation</label>
        </rules>
        <rules>
            <name>updated_reservation</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Reservation_start_and_end_date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Delivery_Format__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Training_Location_City__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Training_Location_State__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Instruction_Time__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reservation_Updated</targetReference>
            </connector>
            <label>updated reservation</label>
        </rules>
        <rules>
            <name>Event_Cancelled</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.B25__Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.B25__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>aDc7e000000Go4pCAC</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.B25__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>aDc7e000000Go54CAC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reservation_Cancellation_notification</targetReference>
            </connector>
            <label>Event Cancelled</label>
        </rules>
        <rules>
            <name>Day_count_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Instruction_Time__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Reservationdateisinpast</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Day_count_changed_notification</targetReference>
            </connector>
            <label>Day count changed</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ReservationDateCheck</name>
        <dataType>Number</dataType>
        <expression>{!$Flow.CurrentDate} -{!$Record.B25__Start_Date__c}</expression>
