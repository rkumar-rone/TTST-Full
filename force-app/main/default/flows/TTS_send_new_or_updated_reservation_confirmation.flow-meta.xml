    </formulas>
    <formulas>
        <name>Reservationdateisinpast</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.B25__Start_Date__c}&lt; DATE(YEAR(TODAY()), MONTH(TODAY()), 1)</expression>
    </formulas>
