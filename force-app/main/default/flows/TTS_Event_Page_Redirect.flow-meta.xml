        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Using the parameters from the page url, get the relevant TTS Event information</description>
        <name>Get_TTS_Event_Info</name>
        <label>Get TTS Event Info</label>
        <locationX>501</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
