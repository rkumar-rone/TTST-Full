    <description>Handles the redirection from /view-event to /course-registration
Replaces static URLs with custom label and introduced a custom redirection LWC to support LWR as well (R1)</description>
    <environments>Default</environments>
    <formulas>
        <name>ConfirmationURL</name>
        <dataType>String</dataType>
        <expression>{!Store_Domain}+&quot;/&quot;+&quot;course-registration?CourseId=&quot;+{!Get_TTS_Event_Info.Id}+&quot;&amp;CourseCode=&quot;+{!Get_TTS_Event_Info.Class_Code__c}</expression>
    </formulas>
    <formulas>
        <name>ProductPageURL</name>
        <dataType>String</dataType>
        <expression>{!Store_Domain} + &quot;/&quot;+&quot;product/detail/&quot;+{!Get_Products.Id}</expression>
    </formulas>
    <formulas>
        <name>Store_Domain</name>
        <dataType>String</dataType>
        <expression>IF({!$Label.SIB_DefaultStorename}==&apos;TTS B2B Store(LWR)&apos;, {!$Label.SIB_LWRSiteURL}, {!$Label.SIB_AuraSiteURL})</expression>
    </formulas>
    <formulas>
        <name>TrimmedID</name>
        <dataType>String</dataType>
        <expression>LEFT({!id}, 15)</expression>
    </formulas>
    <interviewLabel>TTS Event Page Redirect {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>TTS Event Page Redirect</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
