        <description>Represents a percentage to be applied, so that it can be accurate no matter how many sessions are selected.</description>
        <name>DiscountAmount</name>
        <dataType>Number</dataType>
        <expression>(({!Get_TTS_Event.Full_Registration_Cost__c} - {!Get_TTS_Event.Early_Bird_Registration_Cost__c}) / {!Get_TTS_Event.Full_Registration_Cost__c}) * 100</expression>
