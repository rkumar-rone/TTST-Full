public without sharing class UserAuthenticationController {
    @AuraEnabled
	public static String registerUser(String username, String password, String confirm, String firstname, String lastname, String email, String secondaryemail, String phone, String company, String hear, Boolean receiveemails, String country) {
    	List<contact> ct = new List<Contact>();
    	List<Account> portal_acct = [SELECT ID from Account WHERE Name ='TTS Sites Users' limit 1];
     	RecordType r_type = [SELECT ID from RecordType WHERE Name='Sites User' and SObjectType='Contact' limit 1];  
     	Boolean isValidReg = true;
		if(password == null || password.length() < 8 || password.toUpperCase().equals(password) || password.toLowerCase().equals(password) || !password.containsAny('0123456789')) {
			return 'The password must be at least eight characters consisting of at least one uppercase, one lowercase, and one number.';
		}
     	if(password != confirm) {
     		return 'The password and confirmation do not match.';
     	}  
     	if(email != secondaryemail) {
     		return 'The email and confirmation do not match.';
     	}  
     	if(username==null||username=='')
     	{
     		return 'Please enter a username.';
     	}
		if(password==null||password=='')
        {
        	return 'Please enter a password.';              
        }
        if(firstname==null||firstname=='')
        {
            return 'Please enter a value in the first name field.';               
        }
        if(lastname==null||lastname=='')
        {
        	return 'Please enter a value in the last name field.';                
        }
        
        if(email==null||email=='')
        {
        	return 'Please enter an email address';               
        }
        else
        {
				Pattern emailPat=Pattern.compile('[\\w\\.\\-\'\\+]+@([\\w\\-]+\\.)+[a-zA-Z]{2,10}');
                Matcher emailMatch=emailPat.matcher(email);              
                if(!emailMatch.matches())
                {
                        return 'Invalid email address';                        
                }                
        }        
        if(phone==null||phone=='')
        {
        	return 'Please enter a phone number.';
        }
        if(username.contains(' ')) {
        	return 'You cannot have spaces in your username.';
        }
        if(!Moodle.CheckUser(username.toLowerCase())) {
        	
	        ct = [SELECT ID FROM Contact WHERE User_id__c=:username.toLowerCase()];
        	if(!ct.isEmpty())
        	{
	        	return 'Username already exists.';
        	}
	        
        	ct = [SELECT ID FROM Contact WHERE User_Id__c != null and User_Id__c != '' AND email=:email];
        	if(!ct.isEmpty())
        	{
	            return 'User with that email address already exists.';
        	}
        	if(!portal_acct.isEmpty())
        	{
                	ct = [SELECT ID,User_Id__c,Password__c,FirstName,LastName,Email,MobilePhone,Company__c,Receive_E_Mails_From_TTS__c,Secondary_Email__c,How_did_you_hear_about_us__c,GUID__c,AccountId,RecordTypeId,Verify_Password__c FROM Contact WHERE email=:email];
					// AND RecordTypeID!='012A0000000pbKT'
                	//Contact c = new Contact();
                	if(ct.isEmpty()) {
	                	ct.add(new Contact());
						ct[0].RecordTypeId='012A0000000pbKT';
					}
                	
                	ct[0].User_Id__c = username.toLowerCase();
                	ct[0].Salt__c = Math.abs(Crypto.getRandomInteger()).format().replaceAll(',', '');
                	ct[0].Password_New__c= EncodingUtil.base64Encode(Crypto.generateDigest('SHA-512', Blob.valueOf(password + ct[0].Salt__c)));
                	ct[0].FirstName=firstname;
                	ct[0].LastName=lastname;
                	if(email != null && email != '') {
                		ct[0].Email = email;
                	}
                	ct[0].MobilePhone=phone;
	                
                	ct[0].Company__c=company;
                	ct[0].Country_of_Residence__c = country;
                	ct[0].Receive_E_Mails_From_TTS__c=receiveemails;
                	//ct[0].Secondary_Email__c=secondaryemail;
                	ct[0].How_did_you_hear_about_us__c=hear;
                	ct[0].GUID__c=RandomStringUtils.randomUUID();
                	if(ct[0].AccountId == null)
         	    	   	ct[0].AccountId=portal_acct[0].id;
                	
                	//ct[0].Verify_Password__c = confirm;
                	try
                	{
                        	upsert ct;
                        	return 'Success - ' + setSessionKey(username.toLowerCase());                        
                	}
                	catch (Exception e)
                	{
                        
                        
                        return 'An error has occurred= '+e;
                        
                	}
    	   	 }
	        return 'Error with portal account.';
        }
        else {
        	return 'This username is not available as it’s in use on a TTS legacy system.  Please choose another.';
        }
	}
	
	@AuraEnabled
	public static String login(String username, String password) {
		try {
			Contact c = [Select Id, Salt__c, Account_Locked__c, Lockout_Time__c, Failed_Password_Attempts__c, Password_New__c, Password__c from Contact where User_Id__c = :username.toLowerCase()];
			if(c.Account_Locked__c && c.Lockout_Time__c > DateTime.now().addMinutes(-30)) {
				return 'Your account is locked due to consecutive failed login attempts.  Please try again in 30 minutes.';
			}
			if((c.Salt__c == null || c.Salt__c == '' || c.Password_New__c == null || c.Password_New__c == '') &&  c.Password__c.equals(password))
    		{
    			c.Salt__c = Math.abs(Crypto.getRandomInteger()).format().replaceAll(',', '');
                c.Password_New__c= EncodingUtil.base64Encode(Crypto.generateDigest('SHA-512', Blob.valueOf(password + c.Salt__c)));
                c.Last_Login__c = DateTime.now();
				c.Lockout_Time__c = null;
				c.Failed_Password_Attempts__c = 0;
				c.Account_Locked__c = false;
               	update c;
				/*if(pc.Days_to_Confirm_Profile__c != null && c.Last_Modified_User_Information__c != null && c.Last_Modified_User_Information__c.date().daysBetween(Date.today()) >  pc.Days_to_Confirm_Profile__c.intValue()) {
					return 'Success Profile - ' + setSessionKey(username.toLowerCase());
				}*/
                return 'Success - ' + setSessionKey(username.toLowerCase());
    			
    			
    		}
			else if(c.Password_New__c == EncodingUtil.base64Encode(Crypto.generateDigest('SHA-512', Blob.valueOf(password + c.Salt__c)))) {
				c.Last_Login__c = DateTime.now();
				c.Lockout_Time__c = null;
				c.Failed_Password_Attempts__c = 0;
				c.Account_Locked__c = false;
				update c;
				/*if(pc.Days_to_Confirm_Profile__c != null && c.Last_Modified_User_Information__c != null && c.Last_Modified_User_Information__c.date().daysBetween(Date.today()) >  pc.Days_to_Confirm_Profile__c.intValue()) {
					return 'Success Profile - ' + setSessionKey(username.toLowerCase());
				}*/
                return 'Success - ' + setSessionKey(username.toLowerCase());
			}
			else {
				c.Failed_Password_Attempts__c = (c.Failed_Password_Attempts__c == null ? 0 : c.Failed_Password_Attempts__c) + 1;
				if(c.Failed_Password_Attempts__c >= 5) {
					c.Account_Locked__c = true;
					c.Lockout_Time__c = DateTime.now();
				}
				update c;
				if(c.Failed_Password_Attempts__c >= 5) {
					return 'Your account is locked due to consecutive failed login attempts.  Please try again in 30 minutes.';
				}
				else if(c.Failed_Password_Attempts__c == 4) {
					return 'For security reasons, you have 1 attempt remaining before account lockout.  Need to reset your password?  Use the link below.';
				}
			}
		}
		catch(Exception ex) {
			
		}
		return 'Invalid Username or Password.';
	}
	
	public static String setSessionKey(String username) {
		Contact c = [Select Id, User_Id__c from Contact where User_Id__c = :username.toLowerCase()];
		String hashString = Crypto.getRandomInteger().format().replaceAll(',', '') + String.valueOf(Datetime.now().formatGMT('yyyy-MM-dd HH:mm:ss.SSS'));
		Blob hash = Crypto.generateDigest('MD5', Blob.valueOf(hashString));
		String hexSession = EncodingUtil.convertToHex(hash);
		c.Session_Key__c = hexSession;
		update c;
		return c.Session_Key__c + ' - ' + c.User_Id__c;
	}
	
	@AuraEnabled
	public static String resetPasswordEmail(String username) {
		Contact c;
		try {
			 c = [Select Id, User_Id__c from Contact where User_Id__c = :username.toLowerCase()];
		}
		catch(Exception ex) {
			return 'Please check your email for instructions on resetting your password.';
		}
		try {
			String hashString = Crypto.getRandomInteger().format().replaceAll(',', '') + String.valueOf(Datetime.now().formatGMT('yyyy-MM-dd HH:mm:ss.SSS'));
			Blob hash = Crypto.generateDigest('MD5', Blob.valueOf(hashString));
			String hexSession = EncodingUtil.convertToHex(hash);
			c.Password_Key__c = hexSession;
			c.Password_Expiration__c = DateTime.now().addHours(1);
			update c;
		}
		catch(Exception ex) {
			return 'There was an error resetting your password. Please contact Training the Street for more assistance.';
		}
		return 'Please check your email for instructions on resetting your password.';
	}
	
	@AuraEnabled
	public static String forgotUsername(String email) {
		Contact[] conts = [Select Id, Email from Contact where Email = :email];
		if(conts.size() > 1) {
			return 'More than one user exists with that email address. Please contact Training the Street for more assistance.';
		}
		else if(conts.size() == 1){
			conts[0].Send_Username__c = true;
			update conts;
		}
		return 'An email has been sent to your email address with the current username.';
	}
	
	@AuraEnabled
	public static String checkUserKey(String username, String key) {
		try {
			Contact c = [Select Id from Contact where User_Id__c = :username.toLowerCase() and Password_Key__c = :key and Password_Expiration__c != null and Password_Expiration__c >= :dateTime.now()];
			return 'Success';
		}
		catch(Exception ex) {
			
		}
		return 'The reset URL is invalid or has expired.';
	}
	
	@AuraEnabled
	public static String resetPassword(String username, String key, String password, String confirm) {
		if(password != confirm) {
     		return 'The passwords do not match.';
     	} 
     	try {
			Contact c = [Select Id from Contact where User_Id__c = :username.toLowerCase() and Password_Key__c = :key and Password_Expiration__c != null and Password_Expiration__c >= :dateTime.now()];
			c.Salt__c = Math.abs(Crypto.getRandomInteger()).format().replaceAll(',', '');
            c.Password_New__c= EncodingUtil.base64Encode(Crypto.generateDigest('SHA-512', Blob.valueOf(password + c.Salt__c)));
            c.Password_Expiration__c = null;
            update c;
            return 'Success - ' + setSessionKey(username);
			}
		catch(Exception ex) {
			return 'The reset URL is invalid or has expired.';
		} 
     	
	}
	
	@AuraEnabled
	public static String checkSession() {
		try {
			return !Auth.SessionManagement.getCurrentSession().isEmpty() ? 'Success' : 'The session is invalid or has expired.';
		}
		catch(Exception ex) {
			return 'The session is invalid or has expired.';
		}
	}
	
	@AuraEnabled
	public static String logout(String username, String key) {
		try {
			Contact c = [Select Id from Contact where User_Id__c = :username.toLowerCase() and Session_Key__c = :key and Session_Key__c != null and Session_Key__c != '' and Session_Expiration__c != null and Session_Expiration__c >= :DateTime.now()];
			c.Session_Key__c = null;
			c.Session_Expiration__c = null;
			update c;
			return 'Success';
		}
		catch(Exception ex) {
			
		}
		return 'The session is invalid or has expired.';
	}
	
	@AuraEnabled
	public static String changePassword(String username, String key, String password, String confirm, String oldPassword) {
		if(password != confirm) {
			return 'The password and confirmation do not match.';
		}
		if(password != null && password.length() >= 8 && !password.toUpperCase().equals(password) && !password.toLowerCase().equals(password) && password.containsAny('0123456789')) {
			try {
				Contact c = [Select Id, Password_New__c, Salt__c, Failed_Password_Attempts__c from Contact where User_Id__c = :username.toLowerCase() and Session_Key__c = :key and Session_Expiration__c != null and Session_Expiration__c >= :DateTime.now()];
				if(c.Password_New__c == EncodingUtil.base64Encode(Crypto.generateDigest('SHA-512', Blob.valueOf(oldPassword + c.Salt__c)))) {
					c.Salt__c = Math.abs(Crypto.getRandomInteger()).format().replaceAll(',', '');
            		c.Password_New__c= EncodingUtil.base64Encode(Crypto.generateDigest('SHA-512', Blob.valueOf(password + c.Salt__c)));
            		update c;
					return 'Success';
				}
				else {
					c.Failed_Password_Attempts__c = (c.Failed_Password_Attempts__c == null ? 0 : c.Failed_Password_Attempts__c) + 1;
					if(c.Failed_Password_Attempts__c >= 5) {
						c.Account_Locked__c = true;
						c.Lockout_Time__c = DateTime.now();
						setSessionKey(username.toLowerCase());
						update c;
						return 'The Current Password is incorrect. - Redirect';
					}
					update c;
					if(c.Failed_Password_Attempts__c == 4) {
						return 'For security reasons, you have 1 attempt remaining before account lockout.';
					}
					return 'The Current Password is incorrect.';

				}
			}
			catch(Exception ex) {
				return ex.getMessage();
			}
		}
		else {
			return 'The password must be at least eight characters consisting of at least one uppercase, one lowercase, and one number.';
		}
		//return 'The session is invalid or has expired.';
	}
	
