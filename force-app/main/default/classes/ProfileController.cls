public without sharing class ProfileController {
	@AuraEnabled
	public static ContactWrapper loadProfile(String username, String key) {
		if(UserAuthenticationController.checkSession() == 'Success') {
			Contact c = [Select Id, Last_Modified_User_Information__c, FirstName, LastName, Email, MailingStreet, MailingCity, MailingState, MailingPostalCode, Country_of_Residence__c, Secondary_Email__c, MobilePhone, Phone, Company__c, Receive_E_Mails_From_TTS__c, User_Id__c from Contact where User_Id__c = :username];
			return new ContactWrapper(c.FirstName, c.LastName, c.Email, c.Secondary_Email__c, c.MobilePhone, c.Company__c, c.Country_of_Residence__c, c.Receive_E_Mails_From_TTS__c, c.MailingStreet, c.MailingCity, c.MailingState, c.MailingPostalCode, c.User_Id__c, c.Last_Modified_User_Information__c);
		}
		return null;
	}

	@AuraEnabled
	public static String confirmProfile(String username, String key) {
		if(UserAuthenticationController.checkSession() == 'Success') {
			Contact c = [Select Id from Contact where User_Id__c = :username];
			c.Last_Modified_User_Information__c = DateTime.now();
			update c;
			return 'Success';
		}
		return 'Error Confirming Profile.';
	}
	
	@AuraEnabled
	public static String saveProfile(String username, String key, String firstname, String lastname, String email, String secondaryemail, String phone, String company, String country, Boolean receiveemails, String street, String city, String state, String postalcode) {
		if(UserAuthenticationController.checkSession() == 'Success') {
			try {
				Contact c = [Select Id, FirstName, LastName, Email, Secondary_Email__c, Phone, Company__c, Receive_E_Mails_From_TTS__c from Contact where User_Id__c = :username];
				Contact[] cts = [SELECT ID FROM Contact WHERE email=:email and Id != :c.Id];
        		if(cts.isEmpty())
        		{
            		c.FirstName = firstname;
					c.LastName = lastname;
					if(email != null && email != '') {
						c.Email = email;
					}
					c.Secondary_Email__c = secondaryemail;
					c.MobilePhone = phone;
					c.Company__c = company;
					c.Receive_E_Mails_From_TTS__c = receiveemails;
					c.Country_of_Residence__c = country;
					c.MailingStreet = street;
					c.MailingCity = city;
					c.MailingState = state;
					c.MailingPostalCode = postalcode;
					c.Last_Modified_User_Information__c = DateTime.now();
					update c;
					return 'Success';
        		}
				return 'User with that email address already exists.';
			}
			catch(Exception ex) {
				return ex.getMessage();
			}
		}
		return 'Invalid Session';
	}
	
	public class ContactWrapper {
		@AuraEnabled
		public String firstName {get;set;}
		@AuraEnabled
		public String lastName {get;set;}
		@AuraEnabled
		public String email {get;set;}
		@AuraEnabled
		public String secondary {get;set;}
		@AuraEnabled
		public String phone {get;set;}
		@AuraEnabled
		public String company {get;set;}
		@AuraEnabled
		public String country {get;set;}
		@AuraEnabled
		public Boolean receive {get;set;}
		@AuraEnabled
		public String street {get;set;}
		@AuraEnabled
		public String city {get;set;}
		@AuraEnabled
		public String state {get;set;}
		@AuraEnabled
		public String postalcode {get;set;}
		@AuraEnabled
		public String userId {get;set;}
		@AuraEnabled
		public DateTime lastModified {get;set;}
		
		public ContactWrapper(String firstName, String lastName, String email, String secondary, String phone, String company, String country, Boolean receive, String street, String city, String state, String postalcode, String userId, DateTime lastModified) {
			this.firstName = firstName;
			this.lastName = lastName;
			this.email = email;
			this.secondary = secondary;
			this.phone = phone;
			this.company = company;
			this.country = country;
			this.receive = receive;
			this.street = street;
			this.city = city;
			this.state = state;
			this.postalcode = postalcode;
			this.userId = userId;
			this.lastModified = lastModified;
		}
	}
	
