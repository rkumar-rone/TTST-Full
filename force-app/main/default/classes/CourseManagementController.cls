    public class ScheduleReturn {
        @AuraEnabled
        public Boolean success {get;set;}
        @AuraEnabled
        public String error {get;set;}
        @AuraEnabled
        public Boolean hasonline {get;set;}
        @AuraEnabled
        public Schedule[] scheds {get;set;}
        @AuraEnabled
        public String moodleURL {get;set;}
        @AuraEnabled
        public map<String,Object> collevaResp {get;set;}
        
        public ScheduleReturn(Boolean success, String error, Schedule[] scheds, String moodleURL, map<String,Object> collevaResp) {
            this.success = success;
            this.error = error;
            this.scheds = scheds;
            this.hasonline = false;
            this.moodleURL = moodleURL;
            this.collevaResp = collevaResp;
            for(Schedule s : scheds) {
                if(s.cm.Campaign.Sync_to_LMS__c && s.cm.Campaign.Visible_on_LMS__c && s.cm.Contact.LMS_Id__c != null && s.cm.Campaign.LMS_Id__c != null) {
                    System.Debug('found one - ' +  s.cm.Id);
                }
            }
        }
    }
    
