                            if((tempS.cm.Campaign.RecordType.Name == 'SelfStudy Product' && (courseStudyType == 'Self-Study' || courseStudyType == 'All Course Types')) || (tempS.cm.Campaign.RecordType.Name != 'SelfStudy Product' && courseStudyType != 'Self-Study')) {
                                if(!tempS.cm.Campaign.Do_Not_Display_Card_On_Portal__c) {
                                    events.add(tempS);
                                }
                            }
                        }
                    }
                    System.Debug(eventMap.get(i).sessions);
                    System.Debug(eventMap.get(i).regs);
                    if(eventMap.get(i).cm.Campaign.Registration_To_Date__c < Date.today() || eventMap.get(i).sessions == null || eventMap.get(i).sessions.size() == 0 || (eventMap.get(i).regs == null || eventMap.get(i).sessions.size() <= eventMap.get(i).regs.size())) {
                        eventMap.get(i).hasSessionsToReg = false;
                    }
                    else {
                        System.Debug('we reggin');
                        eventMap.get(i).hasSessionsToReg = true;
                    }
                    if(((currentEvent && j == 0) || (!currentEvent && j == 1))) {
                        Schedule tempS = eventMap.get(i);
                        if((tempS.cm.Campaign.RecordType.Name == 'SelfStudy Product' && (courseStudyType == 'Self-Study' || courseStudyType == 'All Course Types')) || (tempS.cm.Campaign.RecordType.Name != 'SelfStudy Product' && courseStudyType != 'Self-Study')) {
                            eventMap.get(i).isActive = currentEvent;
                            if(!tempS.cm.Campaign.Do_Not_Display_Card_On_Portal__c) {
                                events.add(tempS);
                            }
                        }
                    }
                    if(afterMap.containsKey(i) && ((currentEvent && j == 0) || (!currentEvent && j == 1))) {
                        for(Schedule tempS : afterMap.get(i)) {
                            Boolean currentEventAfter = true;
                            if(((tempS.cm.Campaign.EndDate < Date.today()) && (tempS.cm.Date_RC_Access_Ends_Formula__c < DateTime.now()))  || (tempS.cm.Attendee_Status__c != 'Registered' && tempS.cm.Attendee_Status__c != 'Waiting List')) {
                                currentEventAfter = false;
                            }
                            tempS.isActive = currentEventAfter;
                            if((tempS.cm.Campaign.RecordType.Name == 'SelfStudy Product' && (courseStudyType == 'Self-Study' || courseStudyType == 'All Course Types')) || (tempS.cm.Campaign.RecordType.Name != 'SelfStudy Product' && courseStudyType != 'Self-Study')) {
                                if(!tempS.cm.Campaign.Do_Not_Display_Card_On_Portal__c) {
                                    events.add(tempS);
                                }
                            }
                        }
                    }
                }   
            }
            // Map<String, Object> activeProdResp =  getCollevaProductStatus(userCollevaId);
            // if(activeProdResp != null && !activeProdResp.isEmpty()){
            //     return new ScheduleReturn(true, null, events, config.Server_URL__c, activeProdResp);
            // }
            // else{
                return new ScheduleReturn(true, null, events, config.Server_URL__c, null);
            // }
        }
        return new ScheduleReturn(false, checkKey, null, config.Server_URL__c, null); //'The session is invalid or has expired.', null);
    } 
    
