    @AuraEnabled
    public static String cancelCourseProcess(Id campaignMemberId, String courseName) {
        String outcome = 'Failed';
        // Contact c = [Select Id from Contact where User_Id__c = :username.toLowerCase() and Session_Key__c = :key and Session_Key__c != null and Session_Key__c != '' and Session_Expiration__c != null and Session_Expiration__c >= :DateTime.now()];
        Contact c = [Select Id from Contact where User_Id__c = :UserInfo.getUserName()];
        CampaignMember cm = [Select Id, Event_Generated_From__c, Campaign.Class_Code__c, Campaign.Cancellation_Deadline__c, ContactId, CampaignId, Attempted_Registration_Date__c, Order_Summary__c from CampaignMember where Id = :campaignMemberId];
        cm.Attempted_Cancellation_Date__c = DateTime.now();
        // sample id = 00vG00000111TyYIAU. get to the order summary - cm.Order_Summary__c
        List<OrderPaymentSummary> ops = new List<OrderPaymentSummary>();
        List<Schema.Payment> p = new List<Schema.Payment>();
        
        ops = [SELECT Id FROM OrderPaymentSummary WHERE OrderSummaryId = :cm.Order_Summary__c LIMIT 1]; 
        if(ops.size() > 0) {
            p = [SELECT Id, PaymentGroupId, PaymentGroup.SourceObjectId, Amount FROM Payment WHERE OrderPaymentSummaryId = :ops[0].Id AND SfResultCode = 'Success'];
        }
        
        if(cm.Campaign.Cancellation_Deadline__c >= DateTime.now() && p.size() > 0) {
            OrderItemSummary OISummary = [SELECT Id, Status, AdjustedLineAmtWithTax FROM OrderItemSummary WHERE OrderSummaryId = :cm.Order_Summary__c AND Name = :courseName LIMIT 1];
            Payment_Refund__e myEvent = new Payment_Refund__e();
            myEvent.OrderItemSummaryId__c = OISummary.Id;
            myEvent.OrderSummaryId__c = cm.Order_Summary__c;
            EventBus.publish(myEvent);
            String paymentId = p[0].Id;
            ConnectApi.ReferencedRefundRequest refundInput = new ConnectApi.ReferencedRefundRequest();
            refundInput.amount = OISummary.AdjustedLineAmtWithTax;

            ConnectApi.PaymentGroupRequest pgr = new ConnectApi.PaymentGroupRequest();
            pgr.sourceObjectId = p[0].PaymentGroup.SourceObjectId;
            pgr.id = p[0].PaymentGroupId;
            refundInput.paymentGroup = pgr;

            try {
                ConnectApi.ReferencedRefundResponse response = ConnectApi.Payments.refund(refundInput, paymentId);
                //cm.Attendee_Status__c = 'Cancelled';
                cm.Attendee_Status__c = 'Refunded';
                List<Registration__c> lr = [Select Id from Registration__c where Contact__c = :cm.ContactId and (Session__r.Event__c = :cm.CampaignId)];
                for(Registration__c r : lr) {
                    r.Status__c = 'Cancelled';
                }
                update lr;
                outcome = 'Refunded';
            } catch(Exception e) {
                //we failed to refund them
            }
            update cm;
        }
        cm.Attendee_Status__c = 'Cancelled';
        List<Registration__c> lr = [Select Id from Registration__c where Contact__c = :cm.ContactId and (Session__r.Event__c = :cm.CampaignId)];
        for(Registration__c r : lr) {
            r.Status__c = 'Cancelled';
        }
        update lr;
        outcome = 'Cancelled';
        update cm;
        return outcome;
    }

    @AuraEnabled
    public static Map<String, Object> getCollevaProductStatus(Integer collevaId) {
        String methodName = 'getCollevaProductStatus';
        String supportData = '';
        Boolean isValid = false;
        Boolean isSuccess = false;
        String externalId = '';
        Map<String, Object> response = new Map<String, Object>();

        try{
            if(collevaId > 0)
            {
                Contact con = [select id,name,Colleva_Id__c from contact where Colleva_Id__c=:collevaId];
                Map<String, Object> params = new Map<String, Object>();
                params.put('CollevaId', String.valueOf(collevaId));     
                // SIB_CollevaAPIDataVO collevaApiDataVO;    
                // Instantiate and start the Flow
                Flow.Interview.Colleva_API_Allowed_Usage collevaApiCall = new Flow.Interview.Colleva_API_Allowed_Usage(params);
                collevaApiCall.start();
                SIB_CollevaAPIDataVO collevaApiDataVO = (SIB_CollevaAPIDataVO) collevaApiCall.responsedata;
                if(collevaApiDataVO != null){
                    List<SIB_CollevaAPIActiveProductsVO> activeProducts =(List<SIB_CollevaAPIActiveProductsVO>) collevaApiDataVO.activeProducts;
                    System.debug('collevaApiCall : '+ activeProducts);
                    List<SIB_Colleva_Details__c> collevaDetailList = new List<SIB_Colleva_Details__c>();
                    for(SIB_CollevaAPIActiveProductsVO activeProduct : activeProducts)
                    {
                        if(activeProduct.externalId != 'TTS_additionalMinutes' && 
                            Date.valueOf(activeProduct.validUntil) >= System.today()
                            && collevaApiDataVO.minutesLeft >= 0
                            )
                        {
                            externalId = activeProduct.externalId;
                            isValid = true;
                            
                        }
                        SIB_Colleva_Details__c collevaDetail = new SIB_Colleva_Details__c();
                        if(con != null)
                        {   
                            collevaDetail.Contact__c = con.id;
                            collevaDetail.Name = con.Name;
                            collevaDetail.Colleva_Id__c = con.Colleva_Id__c;
                            collevaDetail.ExternalId__c = con.id+'__'+con.Colleva_Id__c+'__'+activeProduct.externalId;
                        }
                        collevaDetail.HasUsageLeft__c = collevaApiDataVO.hasUsageLeft;
                        collevaDetail.IsUnlimited__c = collevaApiDataVO.isUnlimited;
                        collevaDetail.MinutesLeft__c = collevaApiDataVO.minutesLeft;
                        collevaDetail.MinutesLimit__c = collevaApiDataVO.minutesLimit;
                        collevaDetail.SessionsLeft__c = collevaApiDataVO.sessionsLeft;
                        collevaDetail.SessionsLimit__c = collevaApiDataVO.sessionsLimit;
                        collevaDetail.ProductName__c     = activeProduct.productName;
                        collevaDetail.PurchaseType__c = activeProduct.purchaseType;
                        collevaDetail.UsageType__c = activeProduct.usageType;
                        collevaDetail.ValidUntil__c = activeProduct.validUntil;
                        collevaDetailList.add(collevaDetail);

                    }
                    if(collevaDetailList != null && !collevaDetailList.isEmpty())
                    {
                        Database.upsert(collevaDetailList, SIB_Colleva_Details__c.externalId__c);
                    }
                    isSuccess = true;
                }
            }
        }
        catch(Exception ex)
        {
            system.debug(ex);
            SIB_ExceptionLog.storeExceptionLog(ex, 'STOREFRONT', 'MODULE_NAME', 'CourseManagementController', methodName, supportData);             
        }
        
        response.put('success',isSuccess);
        response.put('isProductActive',isValid);
        response.put('collevaId',collevaId);
        response.put('productCode',externalId);
        return response;
    }
    
    
