        if(course != null && course != 'All Courses') {
            query += ' and Event_Description__c = :course ';
        }
        if(month != null) {
            Integer monthInteger = month.intValue();
            query += ' and CALENDAR_MONTH(StartDate) = :monthInteger ';
        }
        if(city != null && city != 'All Cities and Time Zones') {
            query += ' and Training_Location_City__c = :city ';
        }
        if(deliveryFormat != null && deliveryFormat != 'All Delivery Formats') {
            query += ' and Delivery_Format__c = :deliveryFormat ';
        }
        Date startD;
        Date endD;
        if(year != null && year != 'All Years') {
             startD = Date.newInstance(Integer.valueOf(year), 1, 1);
             endD = Date.newInstance(Integer.valueOf(year), 12, 31);
             query += ' and StartDate >= :startD and StartDate <= :endD ';
        }
        query += ' order by StartDate ';
        System.Debug(query);
        Map<Id, Campaign> mapCampaign = new Map<Id, Campaign>((List<Campaign>)Database.query(query));
        Map<Id, Id> mapCampaignIdToProductId = new Map<Id, Id>();
        Map<Id, String> mapCampaignIdToSlugUrl = new Map<Id, String>();
        Map<Id, String> mapCampaignIdToDisplayPrice = new Map<Id, String>();
        for (Product2 product : [SELECT TTS_Event__c, SIB_SlugUrl__c,Display_Price__c FROM Product2 WHERE TTS_Event__c != NULL AND TTS_Event__c IN :mapCampaign.keySet()]) {
            mapCampaignIdToProductId.put(product.TTS_Event__c, product.Id);
            mapCampaignIdToSlugUrl.put(product.TTS_Event__c, product.SIB_SlugUrl__c);
            mapCampaignIdToDisplayPrice.put(product.TTS_Event__c,product.Display_Price__c);
        }
        System.debug('mapCampaignIdToDisplayPrice');
        System.debug(mapCampaignIdToDisplayPrice);
        for(Campaign c : mapCampaign.values()) {
            CampaignReturn cr = new CampaignReturn();
            cr.c = c;
            cr.productId = mapCampaignIdToProductId.get(c.Id) != null ? ((String)mapCampaignIdToProductId.get(c.Id)) : '#';
            cr.productSlugURL = mapCampaignIdToSlugUrl.get(c.Id) != null ? (mapCampaignIdToSlugUrl.get(c.Id)) : null;
            cr.perSession = (c.Total_Sessions__c == null || c.Total_Sessions__c == 0) ? 0 : ((c.Partial_Course_Cost__c == null ? 0 : c.Partial_Course_Cost__c) /c.Total_Sessions__c).setScale(2, System.RoundingMode.HALF_UP);
            cr.productDisplayPrice =  mapCampaignIdToDisplayPrice.get(c.Id) != null ?(mapCampaignIdToDisplayPrice.get(c.Id)) : null;
            System.debug('mmapCampaignIdToDisplayPrice.get(c.Id)');
        System.debug(mapCampaignIdToDisplayPrice.get(c.Id));
            Boolean allRequired = true;
            for(Session__c[] sesses : c.Event_Sessions__r) {
                for(Session__c s : sesses) {
                    if(!s.Required__c) {
                        cr.allRequired = false;
                    }
                }
            }
            Datetime dts = c.StartDate;
            Datetime dte = c.EndDate;
            if (dts.format('EEEE', c.Event_Time_Zone__c) == 'Saturday' || dts.format('EEEE', c.Event_Time_Zone__c) == 'Sunday' || dte.format('EEEE', c.Event_Time_Zone__c) == 'Saturday' || dte.format('EEEE', c.Event_Time_Zone__c) == 'Sunday') {
                cr.weekend = true;
            }
            returnCourses.add(cr);
        }
        return returnCourses;
    }

