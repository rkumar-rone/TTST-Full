            discountVal = event.Discount_Value_3__c;
        }
        else if(event != null && event.Coupon_Code_4__c != '' && event.Coupon_Code_4__c != null && coupon == event.Coupon_Code_4__c && (event.Coupon_4_Expiration__c == null || Date.today() < event.Coupon_4_Expiration__c)) {
            discountType = event.Discount_Type_4__c;
            discountVal = event.Discount_Value_4__c;
        }
        else if((event.Coupon_Code_1__c != null && event.Coupon_Code_1__c != '' && event.Coupon_Code_1__c == coupon && event.Coupon_1_Expiration__c != null && Date.today() > event.Coupon_1_Expiration__c) || (event.Coupon_Code_2__c != null && event.Coupon_Code_2__c != '' && event.Coupon_Code_2__c == coupon && event.Coupon_2_Expiration__c != null && Date.today() > event.Coupon_2_Expiration__c) || (event.Coupon_Code_3__c != null && event.Coupon_Code_3__c != '' && event.Coupon_Code_3__c == coupon && event.Coupon_3_Expiration__c != null && Date.today() > event.Coupon_3_Expiration__c) || (event.Coupon_Code_4__c != null && event.Coupon_Code_4__c != '' && event.Coupon_Code_4__c == coupon && event.Coupon_4_Expiration__c != null && Date.today() > event.Coupon_4_Expiration__c)) {
            response.couponError = 'This coupon code has expired.';
        }
        else if(coupon != null && coupon != '' && coupon != event.Coupon_Code_1__c && coupon != event.Coupon_Code_2__c & coupon != event.Coupon_Code_3__c && coupon != event.Coupon_Code_4__c) {
            response.couponError = 'This coupon code is not valid.';
        }
        if(discountType != null && discountVal != null) {
            if(discountType == '%')
                response.discount = ((response.total == null ? 0 : response.total) - (response.earlyDiscount == null ? 0 : response.earlyDiscount)) * (discountVal / 100);
            else
                response.discount =  discountVal * multiplier;
        }
        response.grandTotal = (response.total == null ? 0 : response.total) - (response.discount == null ? 0 : response.discount);
        for(Transaction__c t : [Select Id, Amount__c, Status__c, (Select Id from Transactions__r) from Transaction__c where Contact__r.User_Id__c = :username.toLowerCase() and status__c in ('Auth', 'Captured', 'Refunded') and Campaign__c = :event.Id]) {
            if(t.Transactions__r == null || t.Transactions__r.size() == 0) {
                response.alreadyPaid = (response.alreadyPaid == null && t.Amount__c == null) ? null : ((response.alreadyPaid == null ? 0 : response.alreadyPaid) + ((t.status__c == 'Refunded') ? (0 - (t.Amount__c == null ? 0 : t.Amount__c)) : (t.Amount__c == null ? 0 : t.Amount__c)));
            } 
        }
        response.grandTotal = ((response.total == null ? 0 : response.total) - (response.discount == null ? 0 : response.discount)) - (response.alreadyPaid == null ? 0 : response.alreadyPaid) - (response.earlydiscount == null ? 0 : response.earlydiscount);
        return response;
    }
    
