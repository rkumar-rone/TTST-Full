            String sessionQuery = 'Select Event__c, Required__c, End_Hours__c, End_Minutes__c, End_AM_PM__c, Start_AM_PM__c, Start_Minutes__c, Start_Hours__c, Waiting_List_Members__c, Id, Instructor__c, Instructor__r.Name, Name, Event__r.Instructor__c, Event__r.Instructor__r.Name, Session_Date__c from Session__c where Event__c in :eventIds';
            String regQuery = 'Select Name, Status__c, Id, Session__r.Event__c, Session__r.Required__c, Session__r.End_Hours__c, Session__r.End_Minutes__c, Session__r.End_AM_PM__c, Session__r.Start_AM_PM__c, Session__r.Start_Minutes__c, Session__r.Start_Hours__c, Session__r.Waiting_List_Members__c, Session__r.Id, Session__r.Instructor__c, Session__r.Instructor__r.Name, Session__r.Name, Session__r.Event__r.Instructor__c, Session__r.Event__r.Instructor__r.Name, Session__r.Session_Date__c from Registration__c where Contact__c = :cId';
            

            /*if(courseType == 'Active Only') {
                campaignQuery += ' and (Campaign.EndDate >= :today or Date_RC_Access_Ends__c >= :today) and Attendee_Status__c in (\'Registered\', \'Waiting List\')';
                sessionQuery += ' and Session_Date__c >= :today';
                regQuery += ' and Session__r.Session_Date__c >= :today and Status__c in (\'Registered\', \'Waiting List\')';
            }
            else if(courseType == 'Inactive Only') {
                campaignQuery += ' and (((Campaign.EndDate < :today or Campaign.EndDate = null) and (Date_RC_Access_Ends__c < :today or Date_RC_Access_Ends__c = null))  or (Attendee_Status__c != \'Registered\' and Attendee_Status__c != \'Waiting List\'))';
                sessionQuery += ' and Session_Date__c < :today';
                regQuery += ' and Session_Date__c < :today';
            }*/
            campaignQuery += ' order by Event_Relationship_Generated_From__r.Position__c, Event_Relationship_Generated_From__r.Sort_Order__c, Campaign.StartDate nulls first';
            sessionQuery += ' order by Session_Date__c';
            regQuery += ' order by Session__r.Session_Date__c';
            System.Debug(campaignQuery);
            Map<Id, CampaignMember> mapCampaignMembers = new Map<Id, CampaignMember>((List<CampaignMember>)Database.query(campaignQuery));
            Set<Id> setCampaigns = new Set<Id>();
            Map<Id, Product2> mapCampaignIdToProduct = new Map<Id, Product2>();
            Map<Id, Product2> mapOfEventAndCollevaProds = new Map<Id, Product2>();

            for(CampaignMember cm : mapCampaignMembers.values()) {
                setCampaigns.add(cm.Campaign.Id);
            }

            for (Product2 product : [SELECT Id, TTS_Event__c, ProductCode, Colleva_Product__c, Colleva_Base_Product__c FROM Product2 WHERE TTS_Event__c IN : setCampaigns]) {
                if(product.Colleva_Product__c){
                    mapOfEventAndCollevaProds.put(product.TTS_Event__c, product);
                }
                mapCampaignIdToProduct.put(product.TTS_Event__c, product);
            }

            Integer userCollevaId;
            Map<Id, Schedule[]> beforeMap = new Map<Id, Schedule[]>();
            Map<Id, Schedule[]> afterMap = new Map<Id, Schedule[]>();
            for(CampaignMember cm : mapCampaignMembers.values()) {
                userCollevaId = Integer.valueOf(cm.contact.Colleva_Id__c);
                DateTime registrationDate = cm.Attempted_Registration_Date__c;
                if (cm.Campaign.RecordType.Name == 'SelfStudy Product' && registrationDate != null && registrationDate.addYears(5) < Date.today() ) {
                    continue;
                }
                DateTime endDate = (cm.Date_RC_Access_Ends_Formula__c == null || (cm.Campaign.EndDate != null && cm.Date_RC_Access_Ends_Formula__c < cm.Campaign.EndDate)) ? cm.Campaign.EndDate : cm.Date_RC_Access_Ends_Formula__c;
                if( ((endDate == null || endDate >= Date.today()) && courseType == 'Active Only' && (cm.Attendee_Status__c == 'Registered' || cm.Attendee_Status__c == 'Waiting List')) || 
                    (endDate != null && endDate < Date.today() && courseType == 'Inactive Only' && cm.Attendee_Status__c != 'Registered' && cm.Attendee_Status__c != 'Waiting List') || 
                    courseType == 'Active and Inactive'
                ) {
                    Schedule sr = new Schedule();
                    sr.showGoTo = true;
                    sr.productId = mapCampaignIdToProduct?.get(cm.Campaign.Id)?.Id;
                    sr.product = mapCampaignIdToProduct?.get(cm.Campaign.Id);
                    if(endDate != null && endDate < Date.today()) {
                        sr.showGoTo = false;
                    }
                    sr.showCancel =(cm.Event_Relationship_Generated_From__c == null && cm.Campaign.Cancellation_Deadline__c != null && (cm.Campaign.EndDate == null || cm.Campaign.EndDate >= Date.today()));
                    sr.cm = cm;
                    eventMap.put(cm.CampaignId, sr);
                    if(cm.Event_Relationship_Generated_From__c != null && cm.Event_Relationship_Generated_From__r.Position__c == 'Before Parent') {
                        if(!beforeMap.containsKey(cm.Event_Relationship_Generated_From__r.Parent__c)) {
                            beforeMap.put(cm.Event_Relationship_Generated_From__r.Parent__c, new Schedule[0]);
                        }
                        beforeMap.get(cm.Event_Relationship_Generated_From__r.Parent__c).add(sr);
                    }
                    else if(cm.Event_Relationship_Generated_From__c != null && cm.Event_Relationship_Generated_From__r.Position__c == 'After Parent') {
                        if(!afterMap.containsKey(cm.Event_Relationship_Generated_From__r.Parent__c)) {
                            afterMap.put(cm.Event_Relationship_Generated_From__r.Parent__c, new Schedule[0]);
                        }
                        afterMap.get(cm.Event_Relationship_Generated_From__r.Parent__c).add(sr);
                    }
                    else {
                        eventIds.add(cm.CampaignId);
                    }
                }
            }
            
            for(Session__c s : Database.query(sessionQuery)) {
                if(eventMap.get(s.Event__c).sessions == null) {
                    eventMap.get(s.Event__c).sessions = new Session__c[0];
                }
                eventMap.get(s.Event__c).sessions.add(s);
            }
            for(Registration__c reg : Database.query(regquery)) {
                if(eventMap.containsKey(reg.Session__r.Event__c)) {
                    if(eventMap.get(reg.Session__r.Event__c).regs == null)
                        eventMap.get(reg.Session__r.Event__c).regs = new Registration__c[0];
                    eventMap.get(reg.Session__r.Event__c).regs.add(reg); 
                }
            }
            for(Integer j = 0; j < 2; j++) {
                for(Id i : eventIds) {
                    Schedule s = eventMap.get(i);
                    Boolean currentEvent = true;
                    if(((s.cm.Campaign.EndDate < Date.today() ||s.cm.Campaign.EndDate == null) && (s.cm.Date_RC_Access_Ends_Formula__c < DateTime.now() || s.cm.Date_RC_Access_Ends_Formula__c == null))  || (s.cm.Attendee_Status__c != 'Registered' && s.cm.Attendee_Status__c != 'Waiting List')) {
                        currentEvent = false;
                    }
                    
                    if(beforeMap.containsKey(i) && ((currentEvent && j == 0) || (!currentEvent && j == 1))) {
                        for(Schedule tempS : beforeMap.get(i)) {
                            Boolean currentEventBefore = true;
                            if(((tempS.cm.Campaign.EndDate < Date.today()) && (tempS.cm.Date_RC_Access_Ends_Formula__c < DateTime.now()))  || (tempS.cm.Attendee_Status__c != 'Registered' && tempS.cm.Attendee_Status__c != 'Waiting List')) {
