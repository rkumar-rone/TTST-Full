    @AuraEnabled
    public static String searchCourses(String username, String key, String coursecode) {
        if(UserAuthenticationController.checkSession() == 'Success') {
            if(coursecode == null || coursecode.length() != 6) {
                return 'Please make sure that the code you entered is 6 characters and does not include spaces when searching for an event.';
            }
            try {
                Campaign c = [Select Id, Registration_From__c, Registration_To__c from Campaign where Class_Code__c = :coursecode];
                if(c.Registration_From__c > dateTime.now()) {
                    return 'Registration has not opened yet for this course.';
                }
                if(c.Registration_To__c < dateTime.now()) {
                    return 'Registration for this course has closed.';
                }
                return 'Success - ' + c.Id;
            }
            catch (Exception ex) {
                return 'No class with this code can be found.';
            }
        }
        return 'The session is invalid or has expired.';
    }
    
