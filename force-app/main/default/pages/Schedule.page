<apex:page controller="Schedule" showHeader="false" sidebar="false"
    title="Your Schedule" action="{!load}" cache="false">
    <apex:stylesheet value="{!$Resource.TTS_Style}" />
    <body leftmargin="0" topmargin="0" marginwidth="0" marginheight="0"
        style="background: url('{!$Resource.TTS_Background}')">
    <table cellSpacing="0" cellPadding="0" width="100%" border="0">
        <tr>
            <td colspan="2" id="masthead"
                style="background: url('{!$Resource.TTS_Fill}')">
            <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                    <td class="headercell" align="left"><img
                        src="{!URLFOR($Resource.login, 'images/topBanner.jpg')}"
                        width="864" height="89" border="0" class="logo-image" /></td>
                </tr>
            </table>
            </td>
        </tr>
    </table>
    <p></p>
    <table cellSpacing="0" cellPadding="0" width="780"
        style="padding: 50px">
        <tr>
            <td align="center"><apex:form id="Form1" forceSSL="true">
                <apex:outputPanel id="errs">
                    <apex:pageMessages />
                </apex:outputPanel>
                <table>
                    <apex:outputPanel rendered="{!loggedIn}">
                        <tr>
                            <td width="250" valign="top"><br />
                            <div id="MenuBar1_Panel_User"></div>
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tbody>
                                    <tr>
                                        <td width="15" rowspan="14"></td>
                                        <td></td>
                                        <td width="10"></td>
                                    </tr>

                                    <!--                                <tr>
                                    <td class="bodytext"><br /><a id="MenuBar1_hlEditUser" href="EditUser.aspx?Id=b25fa18f06154886b7f2eaa5a3a6b24f">Edit Profile</a></td>
                                </tr>          -->
                                    <tr>
                                        <td class="bodytext"><br />
                                        <a href="/register" style="font-size: 1.2em">Logout</a></td>
                                    </tr>

                                </tbody>
                            </table>
                            </td>
                            <td>
                            <table cellSpacing="0" cellPadding="5" width="100%" border="0">
                                <tr>
                                    <td
                                        style="font-weight: bold; font-size: 1.2em; color: #027D07; font-family: Arial, Helvetica, sans-serif; text-align: left;">Your
                                    scheduled events:</td>
                                </tr>
                                <apex:repeat value="{!events}" var="event">
                                    <tr>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #027D07; font-family: Arial, Helvetica, sans-serif; text-align: left;"></td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #027D07; font-family:  Arial, Helvetica, sans-serif; text-align: left;">Event
                                        Name</td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #027D07; font-family: Arial, Helvetica, sans-serif; text-align: left;">Status</td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #027D07; font-family: Arial, Helvetica, sans-serif; text-align: left;">Class
                                        Code</td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #027D07; font-family: Arial, Helvetica, sans-serif; text-align: left;">Event
                                        City</td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #027D07; font-family:  Arial, Helvetica, sans-serif; text-align: left;">Start
                                        Date</td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #027D07; font-family: Arial, Helvetica, sans-serif; text-align: left;">End
                                        Date</td>
                                    </tr>
                                    <!-- <td style="font-weight: bold;font-size: 1.1em;color: #027D07; font-family: Arial, Helvetica, sans-serif;text-align: left;">Instructor</td> -->
                                    <tr>
                                        <td style="font-size: 1.1em; font-weight: bold;"><apex:commandLink value="Cancel"
                                            onclick="return confirm('Are you sure you wish to cancel the Event - {!JSINHTMLENCODE(event.c.Campaign.Online_Event_Name__c)}? Since you are cancelling within the cancellation window, your credit card will not be charged the fees authorized upon registration.');"
                                            action="{!event.cancel}" rendered="{!AND(TODAY()<= event.c.Campaign.Cancellation_Deadline_Date__c, OR(event.c.Attendee_Status__c = 'Waiting List', event.c.Attendee_Status__c = 'Registered'))}"/><apex:commandLink value="Cancel"
                                                onclick="return confirm('Are you sure you wish to cancel the Event - {!JSINHTMLENCODE(event.c.Campaign.Online_Event_Name__c)}? Since the cancellation deadline has passed you may be charged a fee in accordance to the cancellation policy for this event.');"
                                                action="{!event.cancel}"
                                                rendered="{!AND(TODAY() > event.c.Campaign.Cancellation_Deadline_Date__c, OR(event.c.Attendee_Status__c = 'Registered', event.c.Attendee_Status__c = 'Waiting List'))}" /></td>
                                        <td style="font-size: 1.1em; font-weight: bold;">{!event.c.Campaign.Online_Event_Name__c}</td>
                                        <td style="font-size: 1.1em; font-weight: bold;">{!event.c.Attendee_Status__c}</td>
                                        <td style="font-size: 1.1em; font-weight: bold;">{!event.c.Campaign.Class_Code__c}</td>
                                        <td style="font-size: 1.1em; font-weight: bold;">{!event.c.Campaign.Training_Location_City__c}</td>
                                        <td style="font-size: 1.1em; font-weight: bold;">{!TEXT(MONTH(event.c.Campaign.StartDate))&
                                        "/" & TEXT(DAY(event.c.Campaign.StartDate)) & "/" &
                                        TEXT(YEAR(event.c.Campaign.StartDate))}</td>
                                        <td style="font-size: 1.1em; font-weight: bold;">{!TEXT(MONTH(event.c.Campaign.EndDate))
                                        & "/" & TEXT(DAY(event.c.Campaign.EndDate)) & "/" &
                                        TEXT(YEAR(event.c.Campaign.EndDate))}</td>
                                    </tr>
                                    <!-- <td>{!event.c.Campaign.Instructor__r.Name}</td> -->
                                    <tr>
                                        <td></td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #464646; font-family: Arial, Helvetica, sans-serif; text-align: left;">Session
                                        Name</td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #464646; font-family: Arial, Helvetica, sans-serif; text-align: left;">Date</td>
                                        <td
                                            style="font-weight: bold; font-size: 1.1em; color: #464646; font-family: Arial, Helvetica, sans-serif; text-align: left;">#
                                        Waiting List Members</td>
                                    </tr>
                                    <!-- <td style="font-weight: bold;font-size: 1.1em;color: #464646; font-family: Arial, Helvetica, sans-serif;text-align: left;">Instructor</td> -->
                                    <!-- <td style="font-weight: bold;font-size: 1.1em;color: #464646; font-family: Arial, Helvetica, sans-serif;text-align: left;">Start Time</td><td style="font-weight: bold;font-size: 1.1em;color: #027D07; font-family: Arial, Helvetica, sans-serif;text-align: left;">End Time</td> -->
                                    <apex:repeat value="{!event.sessions}" var="session">
                                        <tr></tr>
                                        <tr>
                                            <td></td>
                                            <td style="font-size: 1.1em">{!session.s.Session__r.Name}</td>
                                            <td style="font-size: 1.1em">{!TEXT(MONTH(session.s.Session__r.Session_Date__c))
                                            & "/" & TEXT(DAY(session.s.Session__r.Session_Date__c)) & "/"
                                            & TEXT(YEAR(session.s.Session__r.Session_Date__c))}</td>
                                            <td style="font-size: 1.1em">{!session.s.Session__r.Waiting_List_Members__c}</td>
                                        </tr>
                                        <!-- <td style="font-size:1.1em">{!IF(ISBLANK(session.s.Session__r.Instructor__c), session.s.Session__r.Event__r.Instructor__r.Name , session.s.Session__r.Instructor__r.Name)}</td> -->
                                        <!-- <td style="font-size:1.1em">{!session.s.Session__r.Start_Hours__c}:{!session.s.Session__r.Start_Minutes__c} {!session.s.Session__r.Start_AM_PM__c}</td><td style="font-size:1.1em">{!session.s.Session__r.End_Hours__c}:{!session.s.Session__r.End_Minutes__c} {!session.s.Session__r.End_AM_PM__c}</td> -->
                                    </apex:repeat>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                </apex:repeat>
                            </table>
                            </td>
                        </tr>
                    </apex:outputPanel>
                </table>
            </apex:form></td>
        </tr>


    </table>

    <table cellSpacing="0" cellPadding="0" width="100%" border="0">
        <tr>

            <td class="bodytext">
            <div id="footer" class="footnote" style="font-size: 1em"><BR />
            Having trouble? Please contact us at <a
                href="mailto:Register@trainingthestreet.com">Register@trainingthestreet.com</a>
            or + 1 800 887 1320 <br />
            <p><a href="http://www.trainingthestreet.com/terms.html"
                target="_blank">Terms of Use</a> | <a
                href="http://www.trainingthestreet.com/privacy.html" target="_blank">Privacy
            Policy</a></p>
            <p class="bodytext">TRAINING THE STREET is a trademark owned by
            Training The Street, Inc.</p>
            </div>
            </td>
        </tr>
    </table>
    </body>
</apex:page>