<apex:page controller="ForgotPasswordControllerTTS" showheader="false" title="Training the Street, Inc. - Forgot Password">
<apex:stylesheet value="{!$Resource.TTS_REG_CSS}" />
<body style="background:url('{!$Resource.TTS_Background}')" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0">
        
        <apex:form forceSSL="true">

            <table cellSpacing="0" cellPadding="0"  width="100%" border="0">
                <tr>
                    <td colspan="2"  id="masthead" style="background: url('{!$Resource.TTS_Fill}')">
<table cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td class="headercell" align="left"><img src="{!URLFOR($Resource.TTS_REG_IMG, 'images/topBanner.jpg')}" width="864" height="89" border="0" class="logo-image"/></td>
    </tr>
</table></td>
                </tr>
            </table>
            <p></p>         
            <table id="Table1" cellSpacing="0" cellPadding="0" width="780" border="0">
                <tr>
                    <td width="50"></td>
                    <td>
                        <table cellSpacing="5" cellPadding="0" border="0">
                            <tr>
                                <td colspan="2" class="errorMessage">
                                    <div id="ErrorMessage" class="error">{!error}</div>
                                </td>
                            </tr>
                            <tr>
                                <td width="400" colspan="2" class="bodytext">Please enter username. The 
                                    password associated with the username will be sent to the email address associated with the account.</td>
                            </tr>
                            <tr>
                                <td><br/>
                                </td>
                            </tr>
                            <tr>
                                <td noWrap="nowrap" align="right" colspan="1"><font class="fieldlabel">Username:</font></td>
                                <td colspan="1"><apex:inputText maxlength="50" size="40" id="Username" value="{!username}"/></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="style1">{!message}</td> 
                            <tr>
                                <td align="right" colspan="2"><apex:commandbutton action="{!forgotPassword}" image="{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/Send-2.gif')}" alt="Send" style="border-width:0px"/>&nbsp;&nbsp;<apex:commandbutton action="{!cancel}" image="{!URLFOR($Resource.TTS_REG_IMG,'images/buttons/Cancel-2.gif')}" alt="Cancel" style="border-width:0px"/></td>
                            </tr>
                </tr>
                            </table>
            </td></tr>
        
            </table></apex:form>
    </body>


</apex:page>