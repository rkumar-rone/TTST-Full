<apex:page showHeader="false" sidebar="false" title="Thank You" controller="ThankYou">
<apex:stylesheet value="{!$Resource.TTS_Style}"/>
<body  leftmargin="0" topmargin="0" marginwidth="0" marginheight="0" style="background:url('{!$Resource.TTS_Background}')">
        <table cellSpacing="0" cellPadding="0"  width="100%" border="0">
            <tr>
                <td colspan="2"  id="masthead" style="background: url('{!$Resource.TTS_Fill}')">
<table cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td class="headercell" align="left"><img src="{!URLFOR($Resource.login, 'images/topBanner.jpg')}" width="864" height="89" border="0" class="logo-image"/></td>
    </tr>
</table></td>
            </tr>
        </table>
        <p></p>
        <table cellSpacing="0" cellPadding="0" width="780"  border="0">
            <tr>
                <td align="center">
                    <apex:form id="Form1" forceSSL="true">
                        <apex:outputPanel id="tab"><apex:outputPanel id="errs"><apex:pageMessages /></apex:outputPanel><table cellSpacing="0" cellPadding="5" width="100%" border="0">                      
                            <tr><td colspan="4" style="font-weight: bold;font-size: 1.2em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">Thank you for registering.</td></tr>
                            <tr><td colspan="4" style="font-weight: bold;font-size: 1.2em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">You will be receiving an email confirmation for each session you have registered for.</td></tr>
                            <apex:outputPanel rendered="{!waitlist}"><tr><td colspan="4" style="font-weight: bold;font-size: 1.2em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">You have been waitlisted for the following sessions:</td></tr>
                            <tr><td colspan="2" style="font-weight: bold;font-size: 1.2em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;">Session</td><td style="font-weight: bold;font-size: 1.2em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;" colspan="2">Waiting List Position</td></tr>
                            <apex:repeat value="{!wsessions}" var="ses">
                            <tr><td colspan="2" style="font-weight: bold;font-size: 1.2em; font-family: Arial, Helvetica, sans-serif;text-align: left;">{!ses.sessionname}</td><td style="font-weight: bold;font-size: 1.2em;font-family: Arial, Helvetica, sans-serif;text-align: left;" colspan="2">{!ses.position}</td></tr>
                            </apex:repeat>
                            </apex:outputPanel>
                            <tr><td colspan="4" style="font-weight: bold;font-size: 1.2em;color: #027d07; font-family: Arial, Helvetica, sans-serif;text-align: left;"><apex:commandLink value="Select Additional Events" action="{!selectMore}" /></td></tr>
                        </table>
                        </apex:outputPanel>
                    </apex:form>
                </td>
            </tr>
            
            
        </table>
        
<table cellSpacing="0" cellPadding="0"  width="100%" border="0">
    <tr>  
         
        <td class="bodytext">
          <div id="footer" class="footnote" style="font-size:1em"><BR />
          Having trouble? Please contact us at <a href="mailto:Register@trainingthestreet.com">Register@trainingthestreet.com</a> or + 1 800 887 1320
            <br />
            <p><a href="http://www.trainingthestreet.com/terms.html" target="_blank">Terms of Use</a> | <a href="http://www.trainingthestreet.com/privacy.html" target="_blank">Privacy Policy</a></p>
            <p class="bodytext">TRAINING THE STREET is a trademark owned by Training The Street, Inc.</p>
          </div>        
        </td>
    </tr>
</table>
</body>
</apex:page>