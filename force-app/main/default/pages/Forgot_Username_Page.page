<apex:page showheader="false" controller="Forgot_Username">
<apex:stylesheet value="{!$Resource.TTS_REG_CSS}"/>
<!-- Begin Default Content REMOVE THIS -->
<body style="background:url('{!$Resource.TTS_Background}')" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0">
                <apex:form forceSSL="true">


            <table cellSpacing="0" cellPadding="0"  width="100%" border="0">
                <tr>
                    <td colspan="2"  id="masthead" style="background: url('{!$Resource.TTS_Fill}')">
<table cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td class="headercell" align="left"><img src="{!URLFOR($Resource.TTS_REG_IMG,'images/topBanner.jpg')}" width="864" height="89" border="0" class="logo-image"/></td>
    </tr>
</table></td>
                </tr>
            </table>
            <p></p>         
            <table id="Table1" cellSpacing="0" cellPadding="0" width="780" border="0">
                <tr>
                    <td width="50"></td>
                    <td>
                        <table cellSpacing="5" cellPadding="0" border="0">
                            <tr>
                                <td class="bodytext" colspan="2">
                                    <div id="ErrorMessage" class="error"></div>
                                </td>
                            </tr>
                            <tr>
                                <td width="400" colspan="2" class="bodytext">Please enter your email address. The 
                                    username associated with the email address entered will be displayed below.</td>
                            </tr>
                            <tr>
                                <td><br/>
                                </td>
                            </tr>
                            <tr>
                                <td noWrap="noWrap" align="right" colspan="1"><font class="fieldlabel">Email Address:</font></td>
                                <td colspan="1"><apex:inputtext value="{!email}" maxlength="255"/></td>
                            </tr>
                            <tr>
                                <td></td>
                            <tr>
                                <td align="right" colspan="2"><apex:commandButton action="{!submit}" id="btnSave" tabindex="3" onMouseOver="this.src ='{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/send-over.gif')}';" onMouseOut="this.src = '{!URLFOR($Resource.TTS_REG_IMG,'images/buttons/send.gif')}';" image="{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/Send-2.gif')}" alt="Send" style="border-width:0px"  />&nbsp;&nbsp;<apex:commandbutton action="{!cancel}" id="btnCancel" onMouseOver="this.src = '{!URLFOR($Resource.TTS_REG_IMG,'images/buttons/cancel-over.gif')}';" onMouseOut="this.src = '{!URLFOR($Resource.TTS_REG_IMG,'images/buttons/cancel.gif')}';" image="{!URLFOR($Resource.TTS_REG_IMG,'images/buttons/Cancel-2.gif')}" alt="Cancel" style="border-width:0px" /></td>
                            </tr>
                            <tr>
                                <td align="center" colspan="2" class="sectionlabel"> {!status}<span style="color:black;font-size:larger">{!username}</span></td>
                            </tr>
                            <tr>
                            <td align="center" colspan="2" class="sectionlabel"> <apex:commandLink action="{!redirect_to_login}" value="Back to Login Page" rendered="{!Renderlink}" style="color:black"/></td>
                            
                            </tr>

                </tr>
            </table>
            </td></tr>
            </table></apex:form>
    </body>

<!-- End Default Content REMOVE THIS -->
</apex:page>