<apex:page id="Registration" showHeader="false" controller="SiteRegisterController" title="Training the Street, Inc. - Login and Registration" cache="false">
    
    <apex:stylesheet value="{!$Resource.TTS_REG_CSS}" />
<script language="JavaScript">

function disableEnterKey(e)
{
     var key;     
     if(window.event)
          key = window.event.keyCode; //IE
     else
          key = e.which; //firefox     

     return (key != 13);
}

</script>
<body leftmargin="0" topmargin="0" marginheight="0" marginwidth="0" style="background: url('{!$Resource.TTS_Background}')">

<table cellspacing="0" cellpadding="0" width="100%" border="0">
    <tr>
        <td colspan="2" id="Td1" style="background: url('{!$Resource.TTS_Fill}')">
        <table cellpadding="0" cellspacing="0" border="0" width="100%">
            <tr>
                <td class="headercell" align="left">
                <!-- <img src="{!URLFOR($Resource.TTS_REG_IMG,'images/topBanner.jpg')}" width="864" height="89" border="0" class="logo-image" /> -->
                <img src="{!URLFOR($Resource.login,'images/topBanner.jpg')}" width="864" height="89" border="0" class="logo-image" /> </td>
            </tr>
        </table>
        </td>
    </tr>
</table>
<p></p>
<div>
    <table border="0" cellpadding="3" cellspacing="0">
        <tr>
            <td valign="top"><br />
            </td>
            <td width="25"></td>
            <td valign="top">
            <table id="Panel_Edit" cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                <td colspan="2" align="center" class="fieldlabel" style="text-align:left" color="#027D07;"><p>Welcome to the Training The Street course registration website. Please fill out the appropriate information required on this page in order to view the suite of course options available.</p><ul><li>If you are a returning course participant please use your login credentials to login and view the course dates and options.</li><li>If you are registering for the first time, please fill out the fields below to get started with the registration process.  Once you have completed the required information you will be able to view the course dates and options offered by Training The Street.</li></ul><p>Whether you are attending our public courses or are attending one of our university workshops, we appreciate your business and wish you continued success on your learning journey!</p></td>
                </tr>
                <tr>
                    <td>
                    
                    <!-------------------------------------------------->
                    <table cellspacing="0" cellpadding="5" border="0">
                    <apex:form forceSSL="true">
                        <tr>
                            <td colspan="2" align="center"><b>{!success}</b><span class="errorMessage">{!err}</span></td>
                        </tr>
                                                <tr>
                            <td class="texthighlightlarge" colspan="2">New User 
                            Registration</td>
                        </tr>
                        <tr>
                            <td colspan="2">
                            <span id="lbCreateUsernamePasswordLabel" class="sectionlabel">
                            Create Username and Password</span></td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">* 
                            Username:</td>
                            <td class="bodytext">
                            <apex:inputtext value="{!r_username}" maxlength="255" id="txt_r_username" />
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!r_username_err}</font></span></td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right" style="height: 42px">
                            * Password:</td>
                            <td class="bodytext" style="height: 42px">
                            <apex:inputSecret value="{!r_password}" maxlength="20" id="txtPassword" />
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!r_password_err}</font></span></td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">* 
                            Confirm Password:</td>
                            <td class="bodytext">
                            <apex:inputSecret value="{!confirmPassword}" maxlength="20" id="txtPasswordReenter" />
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp; </span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="sectionlabel"><br />
                            Personal Information</td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right" style="height: 35px">
                            * First Name:</td>
                            <td class="bodytext" style="height: 35px">
                            <apex:inputtext value="{!firstname}" maxlength="50" id="txtFirstName" />
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!firstname_err}</font></span></td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">* 
                            Last Name:</td>
                            <td class="bodytext">
                            <apex:inputText value="{!lastname}" maxlength="50" id="txtLastName" />
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!lastname_err}</font></span></td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">* 
                            Email:</td>
                            <td class="bodytext">
                            <apex:inputtext value="{!email}" maxlength="50" id="txtEmail" />
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!email_err}</font></span></td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">Secondary 
                            Email:</td>
                            <td class="bodytext">
                            <apex:inputText value="{!email2}" maxlength="255" id="txtEmail2" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">*Phone:</td>
                            <td class="bodytext">
                            <apex:inputText value="{!phone}" maxlength="255" id="txtPhone" />
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!phone_err}</font></span></td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">Company/University:</td>
                            <td class="bodytext">
                            <apex:inputText value="{!company}" maxlength="255" id="txtCompany" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fieldlabel" valign="top" align="right">How 
                            did you hear about us?:</td>
                            <td class="bodytext">
                            <apex:inputTextarea value="{!hear_about_us}" id="txtReferredBy" />
                            </td>
                        </tr>
                        <tr>
                            <td class="bodytext" colspan="2">
                            <apex:inputCheckbox value="{!info_box}" />Yes, I would 
                            like to receive emails about TTS products and seminars.<br />
                            <br />
                            </td>
                        </tr>
                        <tr>
                            <td align="center" colspan="2">
                            <apex:commandButton id="r_btnSave" action="{!registerUser}" onMouseOver="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/save-over.gif')}';" onMouseOut="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/save.gif')}';" image="{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/save.gif')}" alt="r_Save" style="border-width:0px" /> 
                                
                                <apex:commandButton action="{!cancel_registration}" id="r_btnCancel" onMouseOver="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/cancel-over.gif')}';" onMouseOut="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/cancel.gif')}';" image="{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/cancel.gif')}" alt="r_Cancel" style="border-width:0px" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2"></td>
                        </tr>
                        <!--------------------BEGINNING ORIGINAL RETURNING USERS----------------------------------------------------->
                        <!------------------------END ORIGINAL RETURNING USERS------------------------------------------------------>
                        <tr>
                            <td colspan="2" class="bodytext"><strong>Note:</strong> 
                            We will not use your personal information for outside 
                            parties.</td>
                        </tr>
                        <tr>
                            <td class="bodytextsmall" colspan="2"><b>*</b> - Required 
                            Fields</td>
                        </tr>
                    </apex:form>
                    </table>
                    <!------------------------------------------------------------------>
                    </td>
                    <td valign="top">
                    <!--------------------------------------->
                    <table cellspacing="0" cellpadding="5" border="0">
                    <apex:form forceSSL="true"> 
                        <tr>
                            <td></td>
                        </tr>
                        <tr>
                            <td class="texthighlightlarge" colspan="2">Returning 
                            Users</td>
                        </tr>
                        <tr>
                            <td nowrap="nowrap" class="fieldlabel" valign="top" align="right">
                            * Username:</td>
                            <td>
                            <apex:inputtext value="{!l_username}" maxlength="255" id="lUsername" />
                            </td>
                            <td class="bodytext" aligh="left" nowrap="nowrap">
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!l_username_err}</font></span></td>
                        </tr>
                        <tr>
                            <td nowrap="nowrap" class="fieldlabel" valign="top" align="right">
                            * Password:</td>
                            <td><apex:inputSecret value="{!l_password}" maxlength="255" id="lPassowrd" />
                            </td>
                            <td nowrap="nowrap" class="bodytext">
                            <span class="errorMessage">&nbsp;&nbsp;&nbsp;
                            <font size="normal">{!l_password_err}</font></span></td>
                        </tr>
                        <tr>
                            <td align="right" colspan="2" style="height: 27px">
                            <apex:commandButton id="l_btnSave" action="{!login}" onMouseOver="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/login-over.gif')}';" onMouseOut="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/login.gif')}';" image="{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/login.gif')}" alt="l_login" style="border-width:0px" /> 
                                
                                <apex:commandButton id="l_btnCancel" action="{!cancel_login}" onMouseOver="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/cancel-over.gif')}';" onMouseOut="this.src = '{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/cancel.gif')}';" image="{!URLFOR($Resource.TTS_REG_IMG, 'images/buttons/cancel.gif')}" alt="l_Cancel" style="border-width:0px" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="bodytext"><br />
                            <br />
                            <br />
                            Forgot your password? Click
                            <a href="/register/ForgotPasswordTTS">
                            here</a><br />
                            <br />
                            Forgot your username? Click
                            <a href="/register/Forgot_Username_Page">
                            here</a> </td>
                        </tr>
                        </apex:form>
                    </table>
                    <!--------------------------->
                    </td>
                                        <td></td>
                </tr>
            </table>
            </td>
        </tr>
    </table>
    <table cellspacing="0" cellpadding="0" width="100%" border="0">
        <tr>
            <td width="150"></td>
            <td class="bodytext">
            <div id="footer" class="footnote">
                <br />
                Having trouble? Please contact us at <a href="mailto:Register@trainingthestreet.com">Register@trainingthestreet.com</a> or + 1 800 887 1320
                <br />
                <p>
                <a href="http://www.trainingthestreet.com/privacy-2/" target="_blank">
                Terms of Use</a> |
                <a href="http://www.trainingthestreet.com/privacy/" target="_blank">
                Privacy Policy</a></p>
                <p class="bodytext">TRAINING THE STREET is a trademark owned by 
                Training The Street, Inc.</p>
            </div>
            </td>
        </tr>
    </table>
</div>

</body>



</apex:page>