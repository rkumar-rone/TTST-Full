    <script>
        $(document).ready(function(){         
            $('#EventTable').DataTable({
                "data": {!JsonData},
                "columns": [
                   { "data": "Event Schedule Name" },
                   { "data": "Type" },
                   { "data": "Start Date" },
                   { "data": "End Date" },
                   { "data": "Status" },
                   { "data": "Next Due Date" },
                   { "data": "Overdue Items" }
                ],
                "order": [[ 2, "asc" ]]
            });
        });
        
        /** Function for loading image **/
        function loading(val) {
            if (val) {
                document.getElementById('contentLoading').style.display = 'inline-block';
            }
            else {
                document.getElementById('contentLoading').style.display = 'none';
            }
        }
        /** Function for showing details of an event-Event Schedule **/
        var old = '';
        function ShowEvent(ESId){
            console.log(' --Event Schedule ID-- '+ESId);
            
            if(ESId == '' || ESId == undefined || ESId == 'null'){
                var b=document.getElementById('Es').style.display;
                if(b=="block" || b==""){
                    showSegment();
                }
                alert('There is no event schedule associated with this event');
            }
            else{
                loading(true);
                ShowEventSchedule(ESId);
            }
        }
        
        function ShowEventSchedule(ESId){
            var b=document.getElementById('Es').style.display;
            console.log(old+' --------- '+ESId);
            if(b=="block" || b==""){
                if(old==ESId){
                    showSegment();
                    loading(false);
                }
                else{
                    showSegment();
                    old=ESId;
                    prepareEvent(ESId);
                }
            }
            else{
                old=ESId;
                prepareEvent(ESId);
            }
        }
        
        function showSegment(){
          $( "#Es" ).animate({
            //opacity: 0.25,
            //left: "+=50",
            height: "toggle"
            }, 1000, function() {
            // Animation complete.
          }); 
        }
        
        function ProcessComplete(){
            loading(false);
        }
        
        function gotoevent(Id){
            window.open('/'+Id,'_blank');
        }
        
        function gotoeventsch(Id){
            window.open('/'+Id,'_blank');
        }
    </script>
    <apex:form >
        <apex:actionFunction name="prepareEvent" action="{!getEventDet}" reRender="segOP,msgs" oncomplete="showSegment();ProcessComplete();">
            <apex:param name="parm1" value="" assignTo="{!eventScheduleId}"/>
        </apex:actionFunction>
        
        <!-- Action Status -->
        <apex:actionStatus id="loading" onstart="loading(true)" onstop="loading(false)" />
        <div id="contentLoading" style="display:none; ">
            <img id="contentLoading1" src="/img/loading32.gif" alt="Loading graphic" />
        </div>
        
        <!-- Page Messages -->
        <apex:pageMessages id="msgs"></apex:pageMessages>
        
        <!-- Event List for Current User -->
        <table id="EventTable" class="display" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th>Event Schedule Name</th>
                    <th>Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Overall Status</th>
                    <th>Next Due Date</th>
                    <th>Overdue Items</th>
                </tr>
            </thead>
        </table>
        
    <!-- Event Schedule Detail Section --->
