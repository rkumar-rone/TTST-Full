                                <apex:commandButton value="Cancel" action="{!cancel}" status="loading" reRender="Eventlst,segOP,msgs" oncomplete="return false;"/>
                                <apex:commandButton value="Go To Event Schedule" oncomplete="gotoeventsch('{!workingEventSchedule.Id}');return false;" status="loading" reRender="Eventlst,msgs"/>
                                <apex:commandButton value="Go To Event" oncomplete="gotoevent('{!CampObj.Id}');return false;" status="loading"/>
                            </apex:pageBlockButtons>
                            
                            <apex:pageBlockSection title="Event Summary" columns="2">
