                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Event Schedule Name"></apex:outputLabel>
                                    <apex:inputText value="{!workingEventSchedule.Name}" styleClass="dis"/>
                                </apex:pageBlockSectionItem>
                                                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="End Date"></apex:outputLabel>
                                    <apex:inputField value="{!workingEventSchedule.End_Date__c}" styleClass="dis" style="background-color: #ccc;"/>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Stage"></apex:outputLabel>
                                    <apex:inputText value="{!workingEventSchedule.Stage__c}" styleClass="dis"/>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Instructor"></apex:outputLabel>
                                    <apex:inputField value="{!workingEventSchedule.Owner.Name}" styleClass="dis"/>
                                </apex:pageBlockSectionItem>
                                
                                <apex:pageBlockSectionItem >
                                    <apex:outputLabel value="Relationship Manager"></apex:outputLabel>
                                    <apex:inputField value="{!workingEventSchedule.Event_Relationship_Manager__r.Name}" styleClass="dis"/>
                                </apex:pageBlockSectionItem>
                                
                            </apex:pageBlockSection>
                            
